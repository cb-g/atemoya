# Activates both toolchains on cd, reverts on leaving. Run `direnv allow` once per machine.

# OCaml: the local switch in ./_opam
eval "$(opam env --switch="$PWD" --set-switch)"

# Python: the uv-managed venv. PATH_add rather than `source .venv/bin/activate` because
# direnv restores environment variables but not shell functions -- activate would leave a
# stray `deactivate` behind after leaving the directory. uv run works without either.
export VIRTUAL_ENV="$PWD/.venv"
PATH_add "$VIRTUAL_ENV/bin"

# Secrets: load .env (gitignored) into the environment on cd, dropped on leaving.
# Nothing in this file is secret; the directive just says where to find them.
dotenv_if_exists

# Reload when dependencies change
watch_file pyproject.toml uv.lock
