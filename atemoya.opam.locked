opam-version: "2.0"
name: "atemoya"
version: "0.1.0"
synopsis: "Quantitative finance models for investment analysis"
description:
  "Fundamentals-based fair-value anchoring for equities, with OCaml valuation engines fed by Python data collection."
maintainer: "cb-g"
authors: "cb-g"
license: "MIT"
homepage: "https://github.com/cb-g/atemoya"
bug-reports: "https://github.com/cb-g/atemoya/issues"
depends: [
  "alcotest" {= "1.9.1" & with-test}
  "astring" {= "0.8.5" & with-test}
  "atd" {= "4.2.0"}
  "atdgen" {= "4.2.0"}
  "atdgen-runtime" {= "4.2.0"}
  "atdpy" {= "4.2.0"}
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "biniou" {= "1.2.2"}
  "camlp-streams" {= "5.0.1"}
  "cmdliner" {= "2.1.1"}
  "cppo" {= "1.8.0" & with-doc}
  "crunch" {= "4.1.0" & with-doc}
  "dune" {= "3.24.2"}
  "easy-format" {= "1.3.4"}
  "fmt" {= "0.11.0" & with-test}
  "fpath" {= "0.7.3" & with-doc}
  "menhir" {= "20260209"}
  "menhirCST" {= "20260209"}
  "menhirGLR" {= "20260209"}
  "menhirLib" {= "20260209"}
  "menhirSdk" {= "20260209"}
  "ocaml" {= "5.3.0"}
  "ocaml-base-compiler" {= "5.3.0"}
  "ocaml-compiler" {= "5.3.0"}
  "ocaml-config" {= "3"}
  "ocaml-options-vanilla" {= "1"}
  "ocaml-syntax-shims" {= "1.0.0" & with-test}
  "ocamlbuild" {= "0.16.1" & with-test}
  "ocamlfind" {= "1.9.8" & with-test}
  "odoc" {= "3.2.1" & with-doc}
  "odoc-parser" {= "3.2.1" & with-doc}
  "ptime" {= "1.2.0" & with-doc}
  "re" {= "1.14.0"}
  "seq" {= "base" & with-doc}
  "stdlib-shims" {= "0.3.0" & with-test}
  "topkg" {= "1.1.1" & with-test}
  "tyxml" {= "4.6.0" & with-doc}
  "uutf" {= "1.0.4" & with-test}
  "yojson" {= "3.0.0"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]