# --- toolchains ---
_opam/
_build/
.venv/
__pycache__/
*.pyc

# --- secrets ---
.env
.env.*
!.env.example
creds.txt
*.key
*.pem
# ThetaTerminal: the jar, its config, logs and any creds file live here; never tracked.
tools/thetaterminal/

# --- generated data ---
# Convention: anything under data/, output/ or log/ is generated and disposable.
# Versioned inputs (ticker universes, country params, config templates) go in
# reference/ instead — never in data/.
**/data/
**/output/
**/log/
# Fetched rates and FX live under data/reference/ (29); never at their old paths either.
data/reference/
reference/risk_free_rates.json
reference/fx_rates.json

# --- editor / OS ---
.DS_Store
*.swp

# --- direnv ---
.direnv/

# --- instructions handed in from outside, read but never committed ---
relay/

# --- AI working instructions: local for now, may be committed later ---
CLAUDE.md
# Local tool settings (deny rules on secrets); never committed.
.claude/
