# Loaded into the environment by direnv (.envrc: dotenv_if_exists) when you cd here.
# Copy to .env (gitignored) and fill in. Never commit .env; the pre-commit hook refuses it.

# FRED API key for python/refresh_rates.py -- https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# SEC EDGAR identity for python/fetch_sec.py, sent verbatim as the User-Agent. SEC's
# fair-access policy requires "<name> <contact email>" on every request; the name is the
# research effort this runs under, the email is the contact. Replace the email. Keep the
# quotes: direnv rejects an unquoted value with a space; the readers strip them.
# https://www.sec.gov/os/accessing-edgar-data
SEC_EDGAR_IDENTITY="rsrch you@example.com"

# ThetaData login for python/theta_terminal.py, obtained from your own ThetaData subscription.
THETADATA_EMAIL=
THETADATA_PASSWORD=
