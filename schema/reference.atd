(* Versioned parameter tables under reference/. Read by OCaml (Params). The risk-free
   file is also written by python/refresh_rates.py, so both sides use generated code:
   atdgen produces Reference_t/Reference_j, atdpy produces python/reference.py.

   Every section carries provenance: [source], [as_of] and [max_age_days]. [as_of] is an
   ISO 8601 date; a monthly or annual vintage is recorded as the first day of its period
   so that ages are conservative. A section older than [max_age_days] at valuation time
   fails the valuation; it is never a warning. Rates are decimal fractions per year. *)

type curve = {
  source : string;
  ~tier : string;                                       (* official | fred_oecd_10y | manual; "" on legacy entries *)
  as_of : string;                                       (* observation date (period end for a monthly average), or copy date *)
  rates : (string * float) list <json repr="object">;   (* requested tenor, e.g. "7y" -> rate *)
  ~estimated : string list;                             (* tenors interpolated, not sourced *)
  ~tenor_used : (string * string) list <json repr="object">;   (* requested tenor -> tenor actually used, where they differ *)
  ~notes : string list;
}

(* Where each country's curve comes from and how it is refreshed. Read by
   python/refresh_rates.py; OCaml reads it only to check it agrees with the rate file. *)
type rate_source = {
  tier : string;                                        (* official | fred_oecd_10y | manual *)
  source : string;                                      (* the issuer or publisher, for the curve's source field *)
  parser : string;                                      (* fred_dgs | fred_oecd_10y | boc_valet | ecb_yc | bundesbank_bbsis | mof_jgb | tesouro_direto | proxy | manual *)
  ~url : string;
  ~series : (string * string) list <json repr="object">;      (* tenor -> series id, column or key, per parser *)
  ~substitute : (string * string) list <json repr="object">;  (* requested tenor -> available tenor to use in its place *)
  ~proxy_of : string;                                   (* another country whose curve stands in *)
  tenors : string list;                                 (* the tenors this source provides, after substitution *)
  ~notes : string list;
}

type rate_sources = {
  source : string;
  as_of : string;
  max_age_days : int;                                   (* the fetched curve file inherits these three (29) *)
  tenors : string list;
  ~aliases : (string * string) list <json repr="object">;
  ~notes : string list;
  ~no_curve_fallback : string list;                     (* (54) domiciles with no reachable official curve whose records take the trading currency's risk-free rate and keep the domicile's country risk premium; a domicile not named here still fails *)
  countries : (string * rate_source) list <json repr="object">;
}

type risk_free_rates = {
  max_age_days : int;
  tenors : string list;                                 (* every curve carries all of these *)
  ~aliases : (string * string) list <json repr="object">;   (* alternate key -> canonical *)
  countries : (string * curve) list <json repr="object">;
  ~notes : string list;
}

(* One value per country: equity risk premium, statutory tax rate, terminal growth. *)
type country_table = {
  source : string;
  as_of : string;
  max_age_days : int;
  ~aliases : (string * string) list <json repr="object">;
  values : (string * float) list <json repr="object">;
  ~notes : string list;
}

type industry_table = {
  source : string;
  as_of : string;
  max_age_days : int;
  values : (string * float) list <json repr="object">;  (* industry string -> beta *)
  ~notes : string list;
}

(* A single global parameter with provenance. *)
type scalar = {
  value : float;
  source : string;
  as_of : string;
  max_age_days : int;
  ~notes : string list;
}

type int_scalar = {
  value : int;
  source : string;
  as_of : string;
  max_age_days : int;
  ~notes : string list;
}

(* Sensitivity steps (23): one fixed symmetric readability step per input kind. Not
   standard deviations and not derived from history; a step is changed by a decision,
   never after seeing a result. *)
type sensitivity_steps = {
  growth : float;                     (* starting growth or ROE0, absolute (0.02 = 2 percentage points) *)
  lambda : float;                     (* mean_reversion_lambda, absolute *)
  terminal_growth : float;            (* absolute *)
  discount_rate : float;              (* WACC or cost of equity, absolute *)
  base_fraction : float;              (* the cash-flow base (fcff, fcff_mid, covered dividend, book equity), as a fraction of the recorded value *)
  source : string;
  as_of : string;
  max_age_days : int;
  ~notes : string list;
}

type params = {
  projection_years : int_scalar;      (* also selects the risk-free tenor: N years -> "Ny" *)
  debt_spread : scalar;               (* pre-tax cost of debt = risk-free + spread *)
  bank_nii_ratio_threshold : scalar;  (* Bank iff net interest income / total revenue >= this *)
  growth_clamp_lower : scalar;        (* the derived starting growth is held to [lower, upper] *)
  growth_clamp_upper : scalar;
  mean_reversion_lambda : scalar;     (* growth, and a bank's ROE, decay toward their anchor at exp(-lambda * t) *)
  mature_market_erp : scalar;         (* the international CAPM's mature-market base; a domicile's total ERP less this is its country risk premium *)
  midcycle_window_years : int_scalar; (* the mid-cycle DCF's window (22): annual periods normalised over, and the period depth the fetch keeps for the class *)
  midcycle_scale_floor : scalar;      (* (55) the smallest opening invested capital, as a fraction of the latest period's, that lets a year into the mid-cycle return average; the reinvestment sums are untouched *)
  interest_evidence_floor : scalar;   (* (65) interest below this fraction of operating income is not evidence that the filer owes anything; read by the fetcher, not by any model *)
  sensitivity_steps : sensitivity_steps;   (* (23) *)
  frontier_draws : int_scalar;        (* (35) draws from the joint belief distribution; a change is a decision *)
  frontier_seed : int_scalar;         (* (35) the sampler's seed; a change is a decision *)
  terminal_growth_rate : country_table;
  unwired : abstract;                 (* kept verbatim from the original parameter file; never read *)
}

(* The fixed ticker set the batch runs over: a declaration, nothing else. Each entry names
   the ticker, the class a human declared for it, why that class (in words that will still
   hold in years: no numbers, fiscal years, tag names or parameter values), and what no
   model can see for the name. Nothing here remembers an outcome or a finding; those belong
   to the run, and "did anything change since the last run" is the baseline diff. The loader
   is strict: an unknown field is a load error. *)
(* The FX hedge's daily spot (48): the ECB's daily reference rates, every currency against
   the euro, a dollar cross being the two ECB rates divided; written by
   python/refresh_fx.py --daily to data/reference/fx_spot_daily.json, never tracked, read by
   the FX hedge only. The valuation path keeps the weekly H.10 series and its age gate. *)
type fx_spot = {
  as_of : string;                       (* the ECB observation date *)
  per_eur : float;                      (* units of the currency per euro, as the ECB quotes it *)
  usd_per_unit : float;                 (* (USD per EUR) / (units per EUR); 1 / per_eur is the euro itself *)
}

type fx_spot_daily = {
  source : string;
  fetched_on : string;
  ~notes : string list;
  currencies : (string * fx_spot) list <json repr="object">;
}

(* CME FX futures (43): transcribed public specifications and the exchange's published
   margins, dated; read by python/hedge_fx.py and never fetched. *)
type fx_future_contract = {
  product : string;                     (* the exchange's product code, e.g. 6E, M6E *)
  size : float;                         (* units of the currency per contract *)
  tick : float;                         (* minimum price fluctuation in the quote convention *)
  tick_value_usd : float;
  maintenance_margin_usd : float;       (* as the exchange publishes it *)
  initial_margin_usd : float;           (* the exchange's speculative initial margin, 110% of maintenance *)
}

type fx_future = {
  quote : string;                       (* usd_per_unit | units_per_usd: how the future is quoted *)
  vendor_symbol : string;               (* the vendor's front-month continuous symbol, for the parity check only *)
  standard : fx_future_contract;
  ?micro : fx_future_contract option;
}

type fx_futures = {
  source : string;
  as_of : string;
  max_age_days : int;
  ~notes : string list;
  contracts : (string * fx_future) list <json repr="object">;   (* currency -> the products *)
}

(* Stretch thresholds (52): declared, dated, with a why; set to fire on two remembered
   episodes and to be rare; changing them is a dated declaration. *)
type stretch_side = {
  dd_120 : float;                       (* the low side reads dd_120; the high side reads above_120_low under the same key name *)
  vs_ma50 : float;
  vs_ma200 : float;
  rsi_14 : float;
}

type stretch_thresholds = {
  as_of : string;
  why : string;
  history_trading_days : int;           (* the window each percentile is taken over: 500, two years *)
  min_history_days : int;               (* 250: fewer closes and the block is null with the reason *)
  low : stretch_side;                   (* at or below fires *)
  high : stretch_side;                  (* at or above fires; dd_120 here means above_120_low *)
  ~notes : string list;
}

(* (60) A build-out declaration: what the new capital will earn once earning, or the whole
   years from spend to first earning. The value is a judgement about this name, the why
   cites the evidence for it (the record's own recent return on capital is the natural
   citation and is never the input), and as_of dates it. Both or neither: a name with one
   of the two gets no readout. *)
type declared_build_out = {
  value : float;
  why : string;
  as_of : string;
}

type universe_entry = {
  ticker : string;
  entity_class : string;                (* a constructor of the boundary's entity_class; validated at load *)
  why : string;                         (* why this class *)
  ~scope_limits : string list;          (* durable: what the models cannot see for this name; carried verbatim *)
  ?cik : string option;                 (* an identifier, not a number (22): the SEC filer to read instead of the ticker map's, with the reason in why *)
  ?lei : string option;                 (* (73) the Legal Entity Identifier whose ESEF annual reports on filings.xbrl.org are the statements, for a name with no SEC filer; declared, never resolved from the vendor *)
  ?adr_ratio : float option;            (* (42) ordinary shares per depositary receipt, positive, from the 20-F's deposit-agreement disclosure cited in why; absent means 1 *)
  ?build_out_return : declared_build_out option;      (* (60) the after-tax return the new capital earns once earning, a decimal *)
  ?build_out_lag_years : declared_build_out option;   (* (60) whole years from spend to first earning *)
}


type universe = {
  ~notes : string list;
  tickers : universe_entry list;
}

(* Which models may run on which entity class, and what the class is judged on instead.
   The only place lens text and admissibility live; the boundary's entity_class variant and
   this table are checked against each other in a test. *)
type class_rule = {
  lens : string;                        (* what the class is judged on *)
  admissible_models : string list;      (* JSON names of boundary model constructors, e.g. "dcf" *)
  never : string;                       (* what must not be used on this class *)
  floor_basis_default : string;         (* what establishes a floor for this class when no model here has *)
  ~scope_limits_default : string list;  (* carried onto every record of the class beside the entry's own (22) *)
  ~floor_present_default : bool nullable;   (* false when the class has no floor by definition; null (absent) when not assessable here *)
}

type admissibility = {
  source : string;
  as_of : string;
  ~notes : string list;
  classes : (string * class_rule) list <json repr="object">;
}

(* FX: where each currency's USD rate comes from, and which country's curve and terminal
   growth a trading currency uses. *)
type fx_source = {
  series : string;                      (* FRED series id *)
  direction : string;                   (* usd_per_unit | units_per_usd, the series' own quote *)
  ~notes : string list;
}

type fx_sources = {
  source : string;
  as_of : string;
  max_age_days : int;
  currency_countries : (string * string) list <json repr="object">;   (* currency -> country whose curve and terminal growth it uses *)
  currencies : (string * fx_source) list <json repr="object">;
  ~notes : string list;
}

type fx_rate = {
  series : string;
  direction : string;
  as_of : string;                       (* observation date *)
  quoted : float;                       (* as the series quotes it *)
  usd_per_unit : float;                 (* normalised: U.S. dollars per one unit of the currency *)
}

type fx_rates = {
  source : string;
  ~notes : string list;
  currencies : (string * fx_rate) list <json repr="object">;
}

(* Which us-gaap tags supply each canonical field from SEC XBRL companyfacts, chosen per
   fiscal period because a filer's tag changes between years. The only place tag names live. *)
type xbrl_field = {
  kind : string;                        (* duration (a flow over the year) | instant (a balance at the year end) *)
  tags : string list;                   (* first present per period wins *)
}

(* Net interest income as a recipe where the taxonomy has no net tag: first present of
   [interest_revenue] less first present of [interest_expense], recorded as "A - B". *)
type nii_recipe = {
  interest_revenue : string list;
  interest_expense : string list;
}

type xbrl_tags = {
  source : string;
  as_of : string;
  ~notes : string list;
  cross_check_threshold : float;        (* relative difference at or below which the two providers agree *)
  max_filing_age_days : int;            (* a newest annual filing older than this fails the valuation *)
  annual_forms : string list;           (* forms whose facts count as annual: 10-K and 20-F families *)
  annual_span_days : int list;          (* [min; max] days a duration fact must span *)
  fields : (string * xbrl_field) list <json repr="object">;             (* us-gaap *)
  ifrs_full_fields : (string * xbrl_field) list <json repr="object">;   (* ifrs-full, the same canonical names (13) *)
  ifrs_full_net_interest_income : nii_recipe;
  depreciation_components : string list;    (* canonical fields summed when no aggregate d&a tag: the first required; both taxonomies *)
  ~dividend_evidence : string list;         (* (65) every element whose presence says the filer distributes to holders, wider than the dividends_paid the models read: none present, with a financing section filed, is the filing saying it distributed nothing *)
  ~financing_section : string list;         (* (65) the cash-flow statement's financing subtotal: filed, it makes the absence of a dividend element mean none rather than not filed *)
  ~preferred_dividend_evidence : string list;   (* (69) the elements moved out of dividend_evidence: a preferred dividend goes to a claim senior to common, so its presence must not make the retention rule read a filer as distributing to common holders *)
  ~redeemable_preferred_evidence : string list; (* (69) redeemable preferred is mezzanine equity and never sits inside stockholders' equity, so a filer that tags one of these needs no book deduction and taking one would double-count *)
}

(* One definition per statement field, applied identically to filed statements (us-gaap
   tags) and to the vendor feed (row labels): reference/field_definitions.json, the only
   place cash, total_debt, delta_nwc and ebit are defined. python/fetch.py reads the vendor
   side, python/fetch_sec.py the xbrl side; OCaml loads it to refuse a record whose
   compositions name another definition. Every list is first-present unless the comment
   says otherwise; [why] carries the reasoning on the record. *)
type cash_xbrl = {
  cash_equivalents : string list;
  restricted_inclusive : string list;       (* cash_equivalents tags that include restricted cash *)
  restricted_cash : string list list;       (* deducted when a restricted_inclusive tag supplied the value: first complete alternative *)
  short_term_investments : string list;     (* optional component *)
  ~investments_inclusive : string list;     (* (62) searched after cash_equivalents: an aggregate that already carries the short-term investments, so the component is not added again *)
}

type cash_vendor = {
  cash_equivalents : string list;
  short_term_investments : string list;     (* optional component *)
  ~not_used : string list;                  (* rows deliberately not read *)
  ~notes : string list;
}

(* ifrs-full components (13). The investment alternatives are tried in order and the first
   with any tag present is summed: IFRS filers split current financial assets by
   measurement category (TSMC), or carry one "other current financial assets" line (SAP). *)
type cash_ifrs = {
  cash_equivalents : string list;
  short_term_investments : string list list;
  ~notes : string list;
}

type cash_definition = {
  name : string;
  why : string;
  xbrl : cash_xbrl;
  ifrs : cash_ifrs;
  vendor : cash_vendor;
}

type debt_xbrl = {
  ~aggregate : string list;                 (* the filer's own long-and-short-term debt aggregate; first choice when filed (25) *)
  ~convertible : string list;               (* convertible notes: beside the aggregate (25), or one component among the others (31) *)
  noncurrent : string list;
  current_total : string list;              (* all debt due within a year as one tag; recipe 1 with noncurrent *)
  current_long_term : string list;          (* the current portion of long-term debt; recipe 2 with noncurrent *)
  short_term_borrowings : string list;      (* optional in recipes 2 and 3 *)
  total_including_current : string list;    (* long-term debt filed with its current portion; recipe 3 *)
  excluded : string list;                   (* operating lease liabilities: never summed *)
  ~interest_evidence : string list;         (* interest tags whose presence says the filer owes something; with no debt tag and none of these, debt is 0 (25) *)
  ~debt_evidence : string list;             (* (72) balance-sheet tags whose presence says the filer owes something (interest payable); read after interest_evidence, under the same sign and size test *)
  ~notes : string list;
}

type debt_vendor = {
  long_term_debt : string list;             (* required *)
  current_debt : string list;               (* optional; already contains commercial paper *)
  current_debt_components : string list;    (* summed when no current_debt row and either is present *)
  ~not_used : string list;
  ~notes : string list;
}

(* ifrs-full recipe (13): [total] (Borrowings, the taxonomy's financial-debt aggregate)
   when tagged; else the sum of the groups present, each first-present, with
   [current_total] standing in for [short_term_borrowings] + [current_portion_of_long_term]
   when tagged, and at least one noncurrent group required. Lease liabilities (all leases
   under IFRS 16) are never summed. *)
type debt_ifrs = {
  total : string list;
  noncurrent_borrowings : string list;
  noncurrent_bonds : string list;
  current_bonds : string list;
  current_total : string list;
  short_term_borrowings : string list;
  current_portion_of_long_term : string list;
  excluded : string list;
  ~notes : string list;
}

type debt_definition = {
  name : string;
  why : string;
  xbrl : debt_xbrl;
  ifrs : debt_ifrs;
  vendor : debt_vendor;
}

type nwc_xbrl = {
  aggregate : string list;                  (* the filed change in operating working capital, positive = cash absorbed *)
  asset_components : string list;           (* positive = the asset grew = cash absorbed: added *)
  liability_components : string list;       (* positive = the liability grew = cash released: subtracted *)
  ~net_components : string list;            (* a balance of assets less liabilities; positive = the net asset grew = cash absorbed: added, asset-signed (25) *)
  excluded : string list;                   (* recognised as outside working capital, never summed *)
  ~notes : string list;
}

type nwc_vendor = {
  change_in_working_capital : string list;
  sign : float;                             (* multiplies the vendor's row into the boundary's sign *)
  ~notes : string list;
}

(* ifrs-full (13): the AdjustmentsFor(Decrease)Increase family is cash-flow-signed (positive
   = cash released) for assets and liabilities alike, so every component enters with
   [sign]. The family is named by [family_prefixes]; a family tag in neither [components]
   nor [excluded] leaves the field null with a note. *)
type nwc_ifrs = {
  family_prefixes : string list;
  components : string list;
  excluded : string list;
  sign : float;
  ~aggregate : string list;             (* (73) the filer's own working-capital total, read only when it tags no family component; in the boundary's sign as measured *)
  ~notes : string list;
}

type nwc_definition = {
  name : string;
  why : string;
  xbrl : nwc_xbrl;
  ifrs : nwc_ifrs;
  vendor : nwc_vendor;
}

(* Pretax income is the record's canonical pretax_income on either provider. The derived
   recipe is pretax + interest_expense - interest_income - other_nonoperating - equity_method,
   each group first-present, subtracted as filed (income-positive). *)
type ebit_rows = {
  operating_income : string list;
  interest_expense : string list;
  interest_income : string list;
  other_nonoperating : string list;
  equity_method : string list;
}

(* How many times a derived recipe may be refined, and the Failed reason when the refined
   value still misses the vendor cross-check (or cannot be checked). Data, so a second
   refinement needs this file changed on purpose. *)
type refinement_policy = {
  max_refinements_per_field : int;
  on_miss : string;
}

type ebit_definition = {
  name : string;
  recipes : string list;                    (* the recipe names a record may carry as ebit_recipe: operating_income, then the one derived recipe *)
  why : string;
  xbrl : ebit_rows;
  ifrs : ebit_rows;                         (* ifrs-full tags (13) *)
  vendor : ebit_rows;
}

(* FFO per NAREIT (18), filed statements only: net income + real-estate depreciation and
   amortisation + impairments - gains on property sales. Net income and depreciation are
   required; impairment and gains are optional (an event, not a line every filer has) and
   an absent one is taken as 0 and recorded as "not filed, taken as 0". *)
type ffo_tags = {
  net_income : string list;
  depreciation : string list;
  impairment : string list;
  gains : string list;
  ~financing_lease_evidence : string list;   (* (54) the net-investment-in-lease balance: necessary, not sufficient, since any investor may hold one *)
  ~financing_lease_income : string list;     (* (54) interest earned on that net investment: with the balance beside it, and no depreciation total filed, the properties are receivables and NAREIT FFO does not apply *)
}

type ffo_definition = {
  name : string;
  why : string;
  xbrl : ffo_tags;
  ifrs : ffo_tags;
  ~notes : string list;
}

(* Two share counts (19), never interchanged. A flow (FFO, net income, dividends) expressed
   per share for a historical period is divided by the period's weighted-average diluted
   count, the shares outstanding while it accrued; a point count (market cap, price x shares)
   is effective shares on the live run and a filed point count point-in-time. *)
type shares_for_flows = {
  name : string;
  why : string;
  xbrl : string list;                       (* first present per period: diluted, then basic (recorded as basic) *)
  ifrs : string list;
  ~notes : string list;
}

type point_count_sources = {
  ~cover_page_max_days_from_period <ocaml default="400"> : int;   (* (44) a cover page dated further than this from the newest filed period is not a point count for it *)
  cover_page : string list;                 (* dei tags, the newest cover page filed by the date *)
  balance_sheet : string list;              (* us-gaap instants at the newest fiscal period end filed by the date *)
}

type shares_for_market_cap = {
  name : string;
  why : string;
  live : string;                            (* effective shares = market cap / price *)
  point_in_time : point_count_sources;      (* tried in order; then Failed *)
  ~notes : string list;
}

(* Depreciation and amortisation (27): when a filer tags several D&A totals in one period,
   the field is the largest, because a total is never smaller than any of its components
   and every candidate is a non-negative aggregate of the same kind; the components fallback
   (depreciation + amortisation of intangibles, tags in xbrl_tags.json) applies only when no
   total is filed. (62) Below the totals, the filer's own cash-flow lines: the combined
   depreciation-and-amortisation line plus the intangible-amortisation line where either is
   filed, then the note pair, which needs both parts or a filing that carries no finite-lived
   intangibles at all. *)
type dna_totals = {
  totals : string list;                 (* every total tag evaluated per period; the largest present wins *)
  ~combined_line : string list;         (* (62) the filer's own depreciation-and-amortisation line in the cash-flow reconciliation, taken with amortization_line beside it *)
  ~amortization_line : string list;     (* (62) the amortisation line in the same reconciliation, preferred over the note element in the component pair *)
  ~finite_lived_intangibles : string list;  (* (62) an instant: with none of these filed, a filer that tags no intangible amortisation has none to tag, and depreciation alone is the period's total *)
}

(* IFRS (32): depreciation and amortisation excluding impairment. The pure tag first; where
   absent, the inclusive tag less the impairment filed (the total, else the sum of the
   components) plus the reversal filed (the total, else its components); the plain
   adjustment tag as a total only when neither is filed. Recorded as a recipe per period. *)
type dna_ifrs = {
  pure : string list;                   (* depreciation and amortisation without impairment *)
  inclusive : string list;              (* depreciation, amortisation and impairment net of reversals *)
  ~inclusive_adjustment : string list;  (* (73) the cash-flow reconciliation's combined adjustment, read after inclusive and only when an impairment figure is tagged beside it, since with none the impairment cannot be taken out *)
  impairment : string list;             (* the impairment total *)
  impairment_components : string list;
  reversal : string list;               (* the reversal total *)
  reversal_components : string list;
  totals : string list;                 (* plain totals, largest wins, when neither pure nor inclusive is filed *)
  ~components : string list;            (* (40) after the totals: every tag required, summed as sum_of_components_ifrs (TSMC files DepreciationExpense and AmortisationExpense only) *)
}

type dna_definition = {
  name : string;
  why : string;
  rule : string;                        (* largest_filed_total *)
  xbrl : dna_totals;
  ifrs : dna_ifrs;
  ~notes : string list;
}

(* Per model (27): the statement fields the latest fiscal period must carry; the mid-cycle
   model needs only the balance sheet, every other model everything it reads. *)
type required_on_latest_period = {
  why : string;
  models : (string * string list) list <json repr="object">;
}

(* AOCI (31): the filed aggregate, else the sum of the filed components, recorded as a
   recipe with every component. *)
type aoci_xbrl = {
  aggregate : string list;
  components : string list;
}

type aoci_definition = {
  name : string;
  why : string;
  recipes : string list;                (* filed | sum_of_components *)
  xbrl : aoci_xbrl;
  ~notes : string list;
}

(* Interest expense for the mid-cycle model's bottom-up NOPAT (31): the filed expense line
   (the ebit definition's tags), else a net non-operating interest figure negated, else
   cash interest paid, each recorded as a recipe on the period. The DCF path never reads
   these stand-ins. *)
type interest_xbrl = {
  net_nonoperating : string list;       (* net income (expense): negated into an expense *)
  paid : string list;                   (* cash paid, standing in *)
}

type interest_definition = {
  name : string;
  why : string;
  recipes : string list;                (* filed | net_nonoperating_interest | interest_paid_stands_in *)
  xbrl : interest_xbrl;
  ~notes : string list;
}

(* The BDC lens (59), filed statements only. The net asset value per share the filer
   states is the anchor; net investment income is the earnings measure that is meant to
   cover the distribution, taken from the filer's own line where there is one and from
   total investment income less total expenses where there is not; the distribution is the
   per-share figure the filer declared or paid. Every list is first-present, and the tag
   taken is recorded on the period, because the three filers verified do not agree on
   which tag they use. *)
type bdc_tags = {
  net_asset_value_per_share : string list;
  net_assets : string list;                 (* the fallback numerator, with shares_outstanding below *)
  shares_outstanding : string list;
  net_investment_income : string list;
  total_investment_income : string list;    (* the recipe's first term *)
  total_expenses : string list;             (* the recipe's second term *)
  distributions_per_share : string list;
  ~notes : string list;
}

type bdc_definition = {
  name : string;
  why : string;
  xbrl : bdc_tags;
  ~notes : string list;
}

type field_definitions = {
  source : string;
  as_of : string;
  ~notes : string list;
  ?depreciation_amortization : dna_definition option;   (* (27) *)
  ?aoci : aoci_definition option;                       (* (31) *)
  ?interest_expense : interest_definition option;       (* (31) *)
  ?required_on_latest_period : required_on_latest_period option;   (* (27) *)
  ?bdc : bdc_definition option;                         (* (59) *)
  cash : cash_definition;
  total_debt : debt_definition;
  delta_nwc : nwc_definition;
  ebit : ebit_definition;
  ffo : ffo_definition;
  shares_for_flows : shares_for_flows;
  shares_for_market_cap : shares_for_market_cap;
  refinement_policy : refinement_policy;
}

(* A declared belief on long-run growth (24): six fields and nothing else, a truncated
   normal. Never estimated from history by the tool; the why may cite history, GDP or base
   rates as evidence, the numbers are the user's. Values are in percentage points: in the
   tracked class table they are offsets around the country's settled terminal growth
   (params.json), so one default serves every currency; in a per-name file they are the
   name's absolute long-run nominal growth. *)
type belief = {
  mean : float;
  sd : float;
  floor : float;
  ceiling : float;
  why : string;
  as_of : string;
}

(* The joint distribution of the beliefs (35): one declared common-factor correlation for
   every pair, with optional per-pair overrides; never estimated from anything. *)
type correlation_pair = {
  a : string;
  b : string;
  rho : float;
  why : string;
  as_of : string;
}

type correlation = {
  common : float;                       (* in [0, 1) *)
  why : string;
  as_of : string;
  ~pairs : correlation_pair list;
}

type class_beliefs = {
  ~notes : string list;
  classes : (string * belief) list <json repr="object">;   (* entity class -> offsets in percentage points *)
  ~names : (string * belief) list <json repr="object">;    (* ticker -> absolute, in percentage points; overrides the class default (26) *)
  ?correlation : correlation option;                       (* (35) *)
}

(* A further file of per-name beliefs given as --beliefs FILE: the same six fields,
   absolute in percentage points; its entries override the tracked ones. *)
type name_beliefs = {
  ~notes : string list;
  tickers : (string * belief) list <json repr="object">;   (* ticker -> absolute, in percentage points *)
}

(* A declared required return (34), beside CAPM: three fields and nothing else, a premium
   in percentage points over the country's risk-free rate at the model's tenor, dated,
   with a why. Never derived from anything by the tool; CAPM is the default and is never
   silently replaced. Both sections ship empty. *)
type required_return = {
  premium_over_rf : float;
  why : string;
  as_of : string;
}

type required_returns = {
  ~notes : string list;
  classes : (string * required_return) list <json repr="object">;
  ~names : (string * required_return) list <json repr="object">;   (* ticker -> overrides the class default *)
}

(* A further file given as --required-returns FILE: the same three fields; its entries
   override the tracked ones. *)
type name_required_returns = {
  ~notes : string list;
  tickers : (string * required_return) list <json repr="object">;
}
