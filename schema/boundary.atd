(* The boundary between Python (vendor ingestion) and OCaml (valuation).

   This file is the only definition of the wire types. atdgen generates the OCaml side
   (Boundary_t, Boundary_j) at build time; atdpy generates python/boundary.py, which dune
   promotes into the source tree. Neither side hand-writes these types.

   Contract for [financials] (Python -> OCaml):
   - Every money field is an absolute amount (not thousands or millions) in [currency].
     If no single currency basis could be established, [currency] is null and the
     valuation must fail rather than guess.
   - A null field means the vendor supplied nothing usable. Never a substituted value.
   - No NaN or infinity crosses the boundary in either direction.
   - [periods] are annual fiscal periods, most recent first. A period in which every
     statement field is null is omitted.
   - [country] and [industry] are the vendor's strings, used only as lookup keys into
     reference/ and, for [industry], as a hint that may fail a classification but never
     make one. Null when the vendor supplied nothing.

   Contract for [valuation] (OCaml -> consumers): one record per ticker. [fair_value],
   [margin_of_safety] and [signal] are non-null iff [status] is [Ok]; [failed_reason] is
   non-null iff [status] is [Failed]; [entity_class] is the human declaration and is null
   iff none was made; [model] is the model the record was routed to and is null when no
   model was admissible for the class or routing failed before one was chosen;
   [class_check] is null iff the signature threshold parameter could not be resolved;
   [inputs] is non-null iff the arithmetic ran to completion, which includes a valuation
   that then failed a sanity check. A model never runs on a class the admissibility table
   does not admit it for. [floor] is always present with a non-empty basis and gates
   nothing here. Every parameter carries its value, lookup key, source, as_of and age in
   days measured at [valued_on], so "where did this number come from" is answerable from
   the record alone. *)

type fiscal_period = {
  period_end : string;                        (* ISO 8601 date, fiscal year end *)
  ebit : float nullable;                      (* operating income; any sign *)
  pretax_income : float nullable;             (* any sign *)
  tax_provision : float nullable;             (* income tax expense; negative = benefit *)
  total_revenue : float nullable;             (* >= 0 *)
  net_interest_income : float nullable;       (* any sign; the vendor reports it for every company *)
  premiums_earned : float nullable;           (* >= 0; insurers only, when the vendor exposes a premium row *)
  premiums_earned_row : string nullable;      (* the vendor's row label that supplied premiums_earned *)
  depreciation_amortization : float nullable; (* >= 0; non-cash add-back, depletion included where the vendor bundles it *)
  depreciation_amortization_row : string nullable;  (* the vendor's row label that supplied it *)
  capex : float nullable;                     (* capital expenditure; >= 0 = cash spent *)
  delta_nwc : float nullable;                 (* increase in net working capital; > 0 = cash absorbed *)
  cash : float nullable;                      (* cash, equivalents and short-term investments; >= 0 *)
  total_debt : float nullable;                (* >= 0; never a substituted zero *)
  total_debt_source : string nullable;        (* the vendor row or row sum that supplied it *)
  book_equity : float nullable;               (* total stockholders' equity at period end; any sign *)
}

type financials = {
  ticker : string;
  as_of : string;                (* ISO 8601 UTC timestamp of the fetch *)
  currency : string nullable;    (* ISO 4217; basis of every money field; null = no single basis *)
  price : float nullable;        (* last price per share; > 0 *)
  market_cap : float nullable;   (* > 0 *)
  country : string nullable;     (* domicile as the vendor spells it, e.g. "United States" *)
  industry : string nullable;    (* industry as the vendor spells it, e.g. "Consumer Electronics" *)
  periods : fiscal_period list;
  notes : string list;           (* free-text provenance and data-quality notes; never branched on *)
}

(* Closed variants: consumers must match every constructor. *)

(* The valuation models that exist. A model runs only where reference/admissibility.json
   lists it for the declared entity class. *)
type model = [ Dcf <json name="dcf"> ]

(* What a company is judged on: a controlled vocabulary of economic drivers, not sectors.
   Declared by a human in reference/universe.json (or on the command line), never inferred.
   Anything else gets a constructor added here, not shoehorned into OperatingCompany. *)
type entity_class = [
  | OperatingCompany     (* FCFF-based DCF; positive, stable free cash flow, no structural break *)
  | Bank                 (* price/book against ROE, loan-loss provisioning coverage as the check *)
  | Insurer              (* operating-profit multiple read with the solvency ratio *)
  | RegulatedUtility     (* rate-base growth and authorised ROE vs own operating EPS guidance *)
  | MerchantPower        (* EV/EBITDA and pre-growth FCF vs the earnings build, by clearing price *)
  | Reit                 (* price/AFFO, dividend coverage by AFFO; never accounting EPS *)
  | Miner                (* NAV and reserve life; never spot FCF *)
  | Royalty              (* NAV of the royalty book; AISC is inverted for this class *)
  | HighGrowthSoftware   (* recurring revenue growth, retention, margin path *)
  | PreProfit            (* cash runway vs the catalyst calendar; no multiple applies *)
  | Wrapper              (* NAV premium/discount plus distribution by source *)
  | ConstructionStage    (* percent complete, distance to first production, debt paydown *)
  | UnderBid             (* the announced offer price; all other valuation suspended *)
  | Ballast              (* nothing; held as a hedge, no directional thesis *)
]
type status = [ Ok | Failed ]
type signal = [ Buy | Hold | Sell ]
type tax_rate_source = [ Effective | Statutory ]
type beta_source = [
  | Industry_table <json name="industry_table">
  | Default_no_industry <json name="default_no_industry">
]
type growth_source = [
  | Fundamental <json name="fundamental">                            (* roic * reinvestment rate *)
  | Historical_capped_at_roic <json name="historical_capped_at_roic"> (* revenue CAGR, held to roic *)
  | Historical <json name="historical">                              (* revenue CAGR *)
]

(* A parameter as used, with its provenance. *)
type parameter = {
  value : float;
  key : string;          (* lookup key: "United States", "United States/7y", "Consumer Electronics", "global" *)
  source : string;
  as_of : string;        (* ISO 8601 date of the source value *)
  age_days : int;        (* valued_on - as_of *)
  ~estimated : bool;     (* the source marks this cell as an interpolation, not a quote *)
}

type int_parameter = {
  value : int;
  key : string;
  source : string;
  as_of : string;
  age_days : int;
}

(* The statement signatures, read as a consistency check against the declared class.
   They never decide the class. *)
type class_check_outcome = [
  | Consistent          (* a signature fired and matches the declaration, or nothing contradicts it *)
  | Signature_absent    (* declared a class the statements can signal, and they did not *)
  | Signature_differs   (* a signature fired for another class; harmless, no inadmissible model could run *)
  | Disagreement        (* fatal: declared OperatingCompany, statements indicate a class the dcf is not admissible for *)
  | Undeclared          (* fatal: no entity_class declared *)
]

type class_check = {
  declared : entity_class nullable;
  indicated : entity_class nullable;      (* what the statements indicate: Bank, Insurer, or null *)
  outcome : class_check_outcome;
  fiscal_period_end : string nullable;    (* the period read; null when there are no periods *)
  total_revenue : float nullable;
  net_interest_income : float nullable;
  nii_ratio : float nullable;             (* net_interest_income / total_revenue; null unless both present and revenue > 0 *)
  bank_nii_ratio_threshold : parameter;   (* the statements indicate Bank iff nii_ratio >= this *)
  premiums_earned : float nullable;       (* the statements indicate Insurer iff > 0, unless Bank *)
  premiums_earned_row : string nullable;
}

(* Whether there is something under the price, and on what basis. Never gates anything
   in this tool; position sizing is the consumer's decision. *)
type floor = {
  present : bool nullable;   (* true: a model verified it; false: the class has none by definition; null: not assessable here *)
  basis : string;            (* what established it, or what would; never empty *)
}

(* Every value the valuation used, plus the intermediates, for audit. Money in
   [valuation.currency]; rates are decimal fractions per year. Growth is derived from the
   statements and never a constant: [g0] is the selected starting growth after the clamp,
   [growth_path] the yearly rates that mean-revert from it toward [terminal_growth_rate]. *)
type inputs = {
  fiscal_period_end : string;
  country : string;                   (* as fetched; each parameter's key is the canonical form *)
  industry : string nullable;
  price : float;
  market_cap : float;
  shares : float;                     (* effective shares = market_cap / price *)
  ebit : float;
  tax_rate : float;                   (* the rate applied *)
  tax_rate_source : tax_rate_source;
  statutory_tax_rate : parameter;     (* the country's rate, applied iff tax_rate_source = Statutory *)
  nopat : float;                      (* ebit * (1 - tax_rate) *)
  depreciation_amortization : float;
  depreciation_amortization_row : string nullable;
  capex : float;
  delta_nwc : float;                  (* mean over delta_nwc_periods *)
  delta_nwc_periods : string list;    (* the fiscal periods averaged, at least 2 *)
  fcff : float;                       (* nopat + d&a - capex - delta_nwc *)
  cash : float;
  total_debt : float;
  total_debt_source : string nullable;
  net_debt : float;                   (* total_debt - cash *)
  book_equity : float;
  invested_capital : float;           (* book_equity + total_debt *)
  roic : float nullable;              (* nopat / invested_capital; null iff invested_capital <= 0 *)
  reinvestment : float;               (* capex + delta_nwc - d&a *)
  reinvestment_rate : float nullable; (* reinvestment / nopat; null iff nopat <= 0 *)
  g_fundamental : float nullable;     (* roic * reinvestment_rate; null when either is *)
  g_historical : float nullable;      (* revenue CAGR over revenue_periods; null with fewer than 3 *)
  revenue_periods : string list;      (* the fiscal periods the CAGR spans *)
  growth_source : growth_source;
  g0 : float;                         (* starting growth, after the clamp *)
  growth_clamped : bool;              (* the clamp changed the selected growth *)
  growth_clamp_lower : parameter;
  growth_clamp_upper : parameter;
  mean_reversion_lambda : parameter;
  growth_path : float list;           (* g_1 .. g_N: terminal + (g0 - terminal) * exp(-lambda * t) *)
  risk_free_rate : parameter;         (* tenor matches projection_years *)
  equity_risk_premium : parameter;    (* the country's total ERP *)
  beta : parameter;
  beta_source : beta_source;
  cost_of_equity : float;             (* risk_free_rate + beta * equity_risk_premium *)
  debt_spread : parameter;
  cost_of_debt : float;               (* pre-tax; risk_free_rate + debt_spread *)
  wacc : float;
  terminal_growth_rate : parameter;
  projection_years : int_parameter;
  enterprise_value : float;
  equity_value : float;               (* enterprise_value - net_debt *)
}

type valuation = {
  ticker : string;
  as_of : string;                     (* the fetch timestamp, from financials *)
  valued_on : string;                 (* ISO 8601 date parameter ages are measured at *)
  currency : string nullable;         (* basis of price and fair_value *)
  price : float nullable;
  fair_value : float nullable;        (* per share *)
  margin_of_safety : float nullable;  (* (fair_value - price) / price *)
  signal : signal nullable;
  entity_class : entity_class nullable;   (* as declared; null iff not declared *)
  model : model nullable;                 (* the model the record was routed to *)
  class_check : class_check nullable;
  floor : floor;
  lens_note : string;                     (* free text from the declaration; may be empty *)
  scope_limits : string list;             (* what the models cannot see for this name, verbatim from the declaration *)
  status : status;
  failed_reason : string nullable;
  inputs : inputs nullable;
}
