(* The boundary between Python (vendor ingestion) and OCaml (valuation).

   This file is the only definition of the wire types. atdgen generates the OCaml side
   (Boundary_t, Boundary_j) at build time; atdpy generates python/boundary.py, which dune
   promotes into the source tree. Neither side hand-writes these types.

   Contract for [financials] (Python -> OCaml):
   - Every money field is an absolute amount (not thousands or millions) in [currency].
     If no single currency basis could be established, [currency] is null and the
     valuation must fail rather than guess.
   - A null field means the vendor supplied nothing usable. Never a substituted value.
   - No NaN or infinity crosses the boundary in either direction.
   - [periods] are annual fiscal periods, most recent first. A period in which every
     statement field is null is omitted.
   - [country] and [industry] are the vendor's strings, used only as lookup keys into
     reference/ and, for [industry], as a hint that may fail a classification but never
     make one. Null when the vendor supplied nothing.

   Contract for [valuation] (OCaml -> consumers): one record per ticker. [fair_value],
   [margin_of_safety] and [signal] are non-null iff [status] is [Ok]; [failed_reason] is
   non-null iff [status] is [Failed]; [entity_class] is the human declaration and is null
   iff none was made; [model] is the model the record was routed to and is null when no
   model was admissible for the class or routing failed before one was chosen;
   [class_check] is null iff the signature threshold parameter could not be resolved;
   [inputs] is non-null iff a model's arithmetic ran to completion, which includes a
   valuation that then failed a sanity check, and is tagged with the model that produced
   it. A model never runs on a class the admissibility table does not admit it for. [floor] is always present with a non-empty basis and gates
   nothing here. Every parameter carries its value, lookup key, source, as_of and age in
   days measured at [valued_on], so "where did this number come from" is answerable from
   the record alone. *)

(* How a defined field was assembled: the definition it follows (its name in
   reference/field_definitions.json, or for ebit the recipe) and the components summed,
   each with the provider's row label or us-gaap tag. Money in the record's currency. *)
type component = {
  name : string;                              (* the component's name in the definition, e.g. "cash_equivalents" *)
  value : float;                              (* as summed: sign already applied *)
  row : string;                               (* the row label or tag that supplied it *)
}

type composition = {
  definition : string;
  components : component list;
}

type fiscal_period = {
  period_end : string;                        (* ISO 8601 date, fiscal year end *)
  ebit : float nullable;                      (* operating income, else pretax income + interest expense (ebit_recipe says which); any sign *)
  pretax_income : float nullable;             (* any sign *)
  tax_provision : float nullable;             (* income tax expense; negative = benefit *)
  total_revenue : float nullable;             (* >= 0 *)
  net_interest_income : float nullable;       (* any sign; the vendor reports it for every company *)
  premiums_earned : float nullable;           (* >= 0; insurers only, when the vendor exposes a premium row *)
  premiums_earned_row : string nullable;      (* the vendor's row label that supplied premiums_earned *)
  depreciation_amortization : float nullable; (* >= 0; non-cash add-back, depletion included where the vendor bundles it *)
  depreciation_amortization_row : string nullable;  (* the vendor's row label that supplied it *)
  capex : float nullable;                     (* capital expenditure; >= 0 = cash spent *)
  delta_nwc : float nullable;                 (* the cash-flow statement's change in operating working capital; > 0 = cash absorbed *)
  cash : float nullable;                      (* cash and equivalents plus short-term investments, restricted cash excluded; >= 0 *)
  total_debt : float nullable;                (* financial debt, operating leases excluded; >= 0; never a substituted zero *)
  total_debt_source : string nullable;        (* the vendor row or row sum that supplied it *)
  book_equity : float nullable;               (* total stockholders' equity at period end; any sign *)
  net_income : float nullable;                (* any sign *)
  dividends_paid : float nullable;            (* >= 0; cash dividends paid in the period *)
  dividends_paid_row : string nullable;
  provision_for_credit_losses : float nullable;   (* >= 0; the vendor exposes no such row on any bank probed (2026-09-18) *)
  provision_for_credit_losses_row : string nullable;
  net_loans : float nullable;                 (* >= 0; banks only *)
  net_loans_row : string nullable;
  (* Present only when the provider is filed statements (optional fields: omitted otherwise). *)
  ?filed : string option;                     (* filing date of the statement this period came from *)
  ?accession : string option;
  ?aoci : float option;                       (* accumulated other comprehensive income, net of tax; any sign *)
  ?aoci_row : string option;
  ?claims_incurred : float option;            (* >= 0; policyholder benefits and claims incurred *)
  ?claims_incurred_row : string option;
  ?benefits_losses_and_expenses : float option;   (* >= 0; the total including acquisition and operating expense *)
  ?benefits_losses_and_expenses_row : string option;
  ?policy_acquisition_expense : float option; (* >= 0 *)
  ?policy_acquisition_expense_row : string option;
  ?operating_expense : float option;          (* >= 0 *)
  ?operating_expense_row : string option;
  ?future_policy_benefits : float option;     (* >= 0; liability at period end *)
  ?future_policy_benefits_row : string option;
  ?claims_liability : float option;           (* >= 0; liability at period end *)
  ?claims_liability_row : string option;
  (* The row (tag) that supplied each core field when the provider records one. *)
  ?total_revenue_row : string option;
  ?ebit_row : string option;
  ?pretax_income_row : string option;
  ?tax_provision_row : string option;
  ?capex_row : string option;
  ?delta_nwc_row : string option;
  ?cash_row : string option;
  ?book_equity_row : string option;
  ?net_income_row : string option;
  ?net_interest_income_row : string option;
  (* The definition each composed field follows and the components summed (11). *)
  (* REIT (18): funds from operations per the definition, filed statements only. *)
  ?ffo : float option;
  ?ffo_composition : composition option;
  ?weighted_shares : float option;            (* the period's weighted-average diluted (else basic) share count, the only count a flow per share may use (19) *)
  ?weighted_shares_tag : string option;
  ?ebit_recipe : string option;               (* "operating_income" | "pretax_plus_interest" *)
  ?ebit_composition : composition option;
  ?interest_expense : float option;           (* the filed interest expense line, first present of the ebit definition's tags or vendor rows (25); the mid-cycle model's bottom-up NOPAT reads it *)
  ?interest_expense_row : string option;
  ?depreciation_amortization_candidates : component list option;   (* (27) every D&A total tag filed for the period with its value; depreciation_amortization_row names the largest, taken *)
  ?cash_composition : composition option;
  ?total_debt_composition : composition option;
  ?delta_nwc_composition : composition option;
}

(* One canonical field compared between the statements provider and the cross-check
   provider for the latest common period. Recorded, never a gate, never resolved. *)
type field_check = {
  field : string;
  primary : float nullable;
  secondary : float nullable;
  relative_difference : float nullable;   (* |primary - secondary| / max(|primary|, |secondary|); null unless both present *)
  agree : bool nullable;                  (* relative_difference <= threshold; null unless both present *)
}

type cross_check = {
  provider : string;                      (* the cross-check provider *)
  ~source : string;                       (* point-in-time (19): "live vendor statements, same fiscal period, fetched after D"; empty on a live record *)
  period_end : string;                    (* the primary's period *)
  secondary_period_end : string;          (* the cross-check provider's matching period *)
  threshold : float;
  fields : field_check list;
  disagreements : int;                    (* fields with agree = false *)
}

(* Whether the vendor quoted the price in the currency's major unit or a minor one (pence,
   cents, agorot). The fetch converts to the major unit and records the divisor. *)
type price_unit = [ Major <json name="major"> | Minor <json name="minor"> ]

(* The newest annual filing SEC's submissions index lists for the filer (14): an
   observable independent of companyfacts. When it is newer than the newest annual facts
   and those facts are past the filing-age gate, the vendor's statements are used and the
   provider_reason says so; the decision is on the record, never a fallback from the gate. *)
type submission = {
  form : string;                 (* 10-K | 20-F *)
  filing_date : string;
  accession : string;
  report_date : string;          (* the fiscal period end the filing reports *)
}

(* Point-in-time (17): the record was assembled as of a past date [as_of_date] with only
   what was known then: facts filed on or before it, the close on the last trading day on
   or before it (the vendor's split-adjusted close multiplied by every split after that
   day), shares from the newest cover page filed by then, rates and FX observed on or
   before it. The valuation fills [anachronistic_inputs] with every parameter whose vintage
   postdates the date (ERP, tax, betas and the assumptions are held at the current vintage,
   declared, never hidden) and refuses the record when no filed statements, shares or rate
   history were available on the date. *)
type point_in_time = {
  as_of_date : string;
  ?price_date : string option;               (* the last trading day on or before as_of_date *)
  ?close_as_served : float option;           (* the vendor's close for that day, split-adjusted as served *)
  ?split_factor : float option;              (* product of the split ratios dated after as_of_date; price = close x factor *)
  ~shares_source : string;                   (* "dei cover page" *)
  ?shares_tag : string option;
  ?shares_as_of : string option;             (* the cover page's own date *)
  ?shares_filed : string option;
  ~rate_observations : (string * string) list <json repr="object">;   (* series -> observation date used *)
  ~anachronistic_inputs : string list;       (* filled by the valuation: "name (vintage as_of)" *)
  ?statements_unavailable : string option;   (* why no filed statements were available on the date *)
  ?shares_unavailable : string option;
  ?rates_unavailable : string option;        (* the currency whose rate source offers no history *)
}

type financials = {
  ticker : string;
  as_of : string;                (* ISO 8601 UTC timestamp of the fetch *)
  currency : string nullable;    (* ISO 4217; the single basis of every money field when statements and price agree; null otherwise *)
  financial_currency : string nullable;   (* what the statements are in *)
  trading_currency : string nullable;     (* what the price and market cap are in, major unit *)
  price_unit : price_unit;       (* how the vendor quoted the price *)
  price_unit_divisor : float;    (* 1 for major; the minor-unit divisor already applied to the price *)
  price : float nullable;        (* last price per share in trading_currency, major unit; > 0 *)
  market_cap : float nullable;   (* in trading_currency; > 0 *)
  country : string nullable;     (* domicile as the vendor spells it, e.g. "United States" *)
  industry : string nullable;    (* industry as the vendor spells it, e.g. "Consumer Electronics" *)
  periods : fiscal_period list;
  notes : string list;           (* free-text provenance and data-quality notes; never branched on *)
  ~provider : string;            (* the statements provider, e.g. "yfinance" or "SEC XBRL companyfacts" *)
  ~taxonomy : string;            (* filed statements only: us-gaap | ifrs-full; empty on vendor statements (13) *)
  ?vendor_financial_currency : string option;   (* filed statements only: the vendor's statement currency, which must agree with financial_currency (the filing's unit) (13) *)
  ~market_provider : string;     (* where price, market cap and currencies came from; always the vendor feed *)
  ~provider_reason : string;     (* why this statements provider was chosen *)
  ~statements_unavailable : string;   (* why the provider had no statements for this ticker; empty when it had *)
  ?latest_filing : string option;     (* ISO date of the newest annual filing the statements come from *)
  ?cross_check : cross_check option;  (* the vendor's statements compared with the filed ones *)
  ?submissions_latest_annual : submission option;   (* every CIK-resolved record (14); absent with the reason below *)
  ?submissions_unavailable : string option;         (* why submissions_latest_annual is absent (14) *)
  ?point_in_time : point_in_time option;            (* present iff the record is a point-in-time one (17) *)
}

(* Closed variants: consumers must match every constructor. *)

(* The valuation models that exist. A model runs only where reference/admissibility.json
   lists it for the declared entity class. *)
type model = [
  | Dcf <json name="dcf">                             (* FCFF DCF; OperatingCompany *)
  | Residual_income <json name="residual_income">     (* excess returns over book; Bank *)
  | Residual_income_insurer <json name="residual_income_insurer">   (* excess returns over AOCI-adjusted book; Insurer *)
  | Reit_ffo_dividend <json name="reit_ffo_dividend">   (* the FFO-covered dividend discounted at the cost of equity; Reit (18) *)
  | Dcf_midcycle <json name="dcf_midcycle">           (* the FCFF DCF on through-cycle earning power; Cyclical (22) *)
]

(* What a company is judged on: a controlled vocabulary of economic drivers, not sectors.
   Declared by a human in reference/universe.json (or on the command line), never inferred.
   Anything else gets a constructor added here, not shoehorned into OperatingCompany. *)
type entity_class = [
  | OperatingCompany     (* FCFF-based DCF; positive, stable free cash flow, no structural break *)
  | Bank                 (* price/book against ROE, loan-loss provisioning coverage as the check *)
  | Insurer              (* operating-profit multiple read with the solvency ratio *)
  | RegulatedUtility     (* rate-base growth and authorised ROE vs own operating EPS guidance *)
  | MerchantPower        (* EV/EBITDA and pre-growth FCF vs the earnings build, by clearing price *)
  | Reit                 (* price/AFFO, dividend coverage by AFFO; never accounting EPS *)
  | Miner                (* NAV and reserve life; never spot FCF *)
  | Royalty              (* NAV of the royalty book; AISC is inverted for this class *)
  | HighGrowthSoftware   (* recurring revenue growth, retention, margin path *)
  | Unprofitable         (* no history of profit to normalise from: cash runway vs the catalyst calendar; no multiple applies (was PreProfit, renamed 22) *)
  | Cyclical             (* earnings set by a commodity price or an industry cycle the company does not control: through-cycle return on today's capital (22) *)
  | Wrapper              (* NAV premium/discount plus distribution by source *)
  | ConstructionStage    (* percent complete, distance to first production, debt paydown *)
  | UnderBid             (* the announced offer price; all other valuation suspended *)
  | Ballast              (* nothing; held as a hedge, no directional thesis *)
]
type status = [ Ok | Failed ]
type signal = [ Buy | Hold | Sell ]
type tax_rate_source = [ Effective | Statutory ]
type beta_source = [
  | Industry_table <json name="industry_table">
  | Default_no_industry <json name="default_no_industry">
]
type growth_source = [
  | Fundamental <json name="fundamental">                            (* roic * reinvestment rate *)
  | Historical_capped_at_roic <json name="historical_capped_at_roic"> (* revenue CAGR, held to roic *)
  | Historical <json name="historical">                              (* revenue CAGR *)
]

(* How a cross-currency record was converted: every statement total was multiplied by
   [fx_rate] (trading currency per unit of financial currency, through USD) before the
   model ran; the discount rate and terminal growth are the trading currency's country's,
   the tax rate the domicile's. Present only on the cross-currency path. *)
type conversion = {
  financial_currency : string;
  trading_currency : string;
  fx_rate : float;                  (* trading per financial *)
  fx_usd_per_financial : float;
  fx_usd_per_trading : float;
  fx_source : string;
  fx_as_of : string;
  fx_age_days : int;
  domicile : string;
  rate_country : string;            (* risk-free rate and terminal growth *)
  growth_country : string;
  price_unit : price_unit;
  price_unit_divisor : float;
}

(* A parameter as used, with its provenance. *)
type parameter = {
  value : float;
  key : string;          (* lookup key: "United States", "United States/7y", "Consumer Electronics", "global" *)
  source : string;
  as_of : string;        (* ISO 8601 date of the source value *)
  age_days : int;        (* valued_on - as_of *)
  ~estimated : bool;     (* the source marks this cell as an interpolation, not a quote *)
  ~tier : string;        (* risk-free only: official | fred_oecd_10y | manual *)
  ~tenor_requested : string;   (* risk-free only: the tenor the horizon asked for *)
  ~tenor_used : string;        (* risk-free only: the tenor supplied; differs on a recorded substitution *)
}

type int_parameter = {
  value : int;
  key : string;
  source : string;
  as_of : string;
  age_days : int;
}

(* The statement signatures, read as a consistency check against the declared class.
   They never decide the class. *)
type class_check_outcome = [
  | Consistent          (* a signature fired and matches the declaration, or nothing contradicts it *)
  | Signature_absent    (* declared a class the statements can signal, and they did not *)
  | Signature_differs   (* a signature fired for another class; harmless, no inadmissible model could run *)
  | Disagreement        (* fatal: declared OperatingCompany, statements indicate a class the dcf is not admissible for *)
  | Undeclared          (* fatal: no entity_class declared *)
]

type class_check = {
  declared : entity_class nullable;
  indicated : entity_class nullable;      (* what the statements indicate: Bank, Insurer, or null *)
  outcome : class_check_outcome;
  fiscal_period_end : string nullable;    (* the period read; null when there are no periods *)
  total_revenue : float nullable;
  net_interest_income : float nullable;
  nii_ratio : float nullable;             (* net_interest_income / total_revenue; null unless both present and revenue > 0 *)
  bank_nii_ratio_threshold : parameter;   (* the statements indicate Bank iff nii_ratio >= this *)
  premiums_earned : float nullable;       (* the statements indicate Insurer iff > 0, unless Bank *)
  premiums_earned_row : string nullable;
}

(* Whether there is something under the price, and on what basis. Never gates anything
   in this tool; position sizing is the consumer's decision. *)
type floor = {
  present : bool nullable;   (* true: a model verified it; false: the class has none by definition; null: not assessable here *)
  basis : string;            (* what established it, or what would; never empty *)
}

(* Every value the valuation used, plus the intermediates, for audit. Money in
   [valuation.currency]; rates are decimal fractions per year. Growth is derived from the
   statements and never a constant: [g0] is the selected starting growth after the clamp,
   [growth_path] the yearly rates that mean-revert from it toward [terminal_growth_rate]. *)
type inputs = {
  fiscal_period_end : string;
  country : string;                   (* as fetched; each parameter's key is the canonical form *)
  industry : string nullable;
  price : float;
  market_cap : float;
  shares : float;                     (* effective shares = market_cap / price *)
  ebit : float nullable;              (* null only on the mid-cycle path when the latest period lacks the lines its spot nopat needs (27) *)
  ?ebit_recipe : string option;       (* operating_income | pretax_plus_interest; omitted on a record fetched before the definitions *)
  ?ebit_composition : composition option;
  tax_rate : float;                   (* the rate applied *)
  tax_rate_source : tax_rate_source;
  statutory_tax_rate : parameter;     (* the country's rate, applied iff tax_rate_source = Statutory *)
  nopat : float;                      (* ebit * (1 - tax_rate) *)
  depreciation_amortization : float nullable;   (* null only on the mid-cycle path when the latest period lacks the flow (27) *)
  depreciation_amortization_row : string nullable;
  capex : float nullable;             (* likewise *)
  delta_nwc : float nullable;         (* mean over delta_nwc_periods; likewise *)
  delta_nwc_periods : string list;    (* the fiscal periods averaged, at least 2 on the dcf *)
  ~delta_nwc_compositions : composition nullable list;   (* one per averaged period, in the same order; empty before the definitions *)
  fcff : float;                       (* nopat + d&a - capex - delta_nwc *)
  cash : float;
  ?cash_composition : composition option;
  total_debt : float;
  total_debt_source : string nullable;
  ?total_debt_composition : composition option;
  net_debt : float;                   (* total_debt - cash *)
  book_equity : float;
  invested_capital : float;           (* book_equity + total_debt *)
  roic : float nullable;              (* nopat / invested_capital; null iff invested_capital <= 0 *)
  reinvestment : float;               (* capex + delta_nwc - d&a *)
  reinvestment_rate : float nullable; (* reinvestment / nopat; null iff nopat <= 0 *)
  g_fundamental : float nullable;     (* roic * reinvestment_rate; null when either is *)
  g_historical : float nullable;      (* revenue CAGR over revenue_periods; null with fewer than 3 *)
  revenue_periods : string list;      (* the fiscal periods the CAGR spans *)
  growth_source : growth_source;
  g0 : float;                         (* starting growth, after the clamp *)
  growth_clamped : bool;              (* the clamp changed the selected growth *)
  growth_clamp_lower : parameter;
  growth_clamp_upper : parameter;
  mean_reversion_lambda : parameter;
  growth_path : float list;           (* g_1 .. g_N: terminal + (g0 - terminal) * exp(-lambda * t) *)
  risk_free_rate : parameter;         (* tenor matches projection_years *)
  equity_risk_premium : parameter;    (* the domicile's total ERP; on the cross-currency path the mature-market base *)
  ?country_risk_premium : parameter option;   (* cross-currency only: domicile total ERP less the mature-market base *)
  beta : parameter;
  beta_source : beta_source;
  cost_of_equity : float;             (* risk_free_rate + beta * equity_risk_premium (+ country_risk_premium) *)
  ?conversion : conversion option;    (* cross-currency only *)
  debt_spread : parameter;
  cost_of_debt : float;               (* pre-tax; risk_free_rate + debt_spread *)
  wacc : float;
  terminal_growth_rate : parameter;
  projection_years : int_parameter;
  enterprise_value : float;
  equity_value : float;               (* enterprise_value - net_debt *)
}

(* Every value the residual-income model used, plus the intermediates. Fair equity value
   = book value today + PV of excess returns (ROE_t - cost of equity) x start-of-year book
   over the explicit years, with ROE mean-reverting toward the cost of equity and book
   compounding by retained earnings. There is no terminal: ROE has reverted to the cost of
   equity by then, and growth at the cost of equity is value neutral, so book growth beyond
   the explicit years is worth nothing without an excess return (15). Never an earnings
   multiple, anywhere. The loan-loss ratios are recorded for the reader and gate nothing. *)
type residual_income_inputs = {
  fiscal_period_end : string;
  country : string;
  industry : string nullable;
  price : float;
  market_cap : float;
  shares : float;                     (* effective shares = market_cap / price *)
  book_equity : float;                (* latest period; > 0 *)
  book_value_per_share : float;
  net_income : float;                 (* latest period *)
  roe_0 : float;                      (* mean of net_income / book_equity over roe_periods *)
  roe_periods : string list;          (* at least 2 *)
  payout_ratio : float;               (* mean of dividends_paid / net_income over payout_periods, clamped to [0, 1] *)
  retention : float;                  (* 1 - payout_ratio; buybacks are not payout here *)
  payout_periods : string list;       (* at least 2 *)
  dividends_paid : float nullable;    (* latest period *)
  dividends_paid_row : string nullable;
  risk_free_rate : parameter;
  equity_risk_premium : parameter;    (* the domicile's total ERP; on the cross-currency path the mature-market base *)
  ?country_risk_premium : parameter option;   (* cross-currency only *)
  beta : parameter;
  beta_source : beta_source;
  cost_of_equity : float;             (* risk_free_rate + beta * equity_risk_premium (+ country_risk_premium) *)
  ?conversion : conversion option;    (* cross-currency only *)
  mean_reversion_lambda : parameter;
  projection_years : int_parameter;
  roe_path : float list;              (* ROE_1 .. ROE_N: ke + (roe_0 - ke) * exp(-lambda * t) *)
  book_value_path : float list;       (* start-of-year book for years 1 .. N *)
  excess_return_path : float list;    (* (ROE_t - ke) * book at start of t *)
  pv_excess_returns : float;
  equity_value : float;               (* book_equity + pv_excess_returns *)
  justified_price_to_book : float;    (* equity_value / book_equity *)
  net_interest_income : float nullable;
  provision_for_credit_losses : float nullable;
  provision_for_credit_losses_row : string nullable;
  provision_to_net_interest_income : float nullable;
  net_loans : float nullable;
  net_loans_row : string nullable;
  provision_to_net_loans : float nullable;
}

(* The insurer model: the residual-income core run on AOCI-adjusted book (reported
   stockholders' equity less accumulated other comprehensive income, per period), from
   filed statements, plus the underwriting checks the lens says to read it with. The
   checks are recorded, never gates; solvency is declared null, never fabricated. *)
type insurer_inputs = {
  core : residual_income_inputs;      (* core.book_equity is the AOCI-adjusted book *)
  provider : string;
  filed : string nullable;
  accession : string nullable;
  reported_book_equity : float;
  aoci : float;
  aoci_row : string nullable;
  aoci_to_reported_book : float;      (* how much of reported book was adjusted away *)
  premiums_earned : float;
  premiums_earned_row : string nullable;
  claims_incurred : float nullable;
  claims_incurred_row : string nullable;
  benefits_losses_and_expenses : float nullable;
  benefits_losses_and_expenses_row : string nullable;
  policy_acquisition_expense : float nullable;
  policy_acquisition_expense_row : string nullable;
  operating_expense : float nullable;
  operating_expense_row : string nullable;
  combined_ratio_proxy : float nullable;
  combined_ratio_basis : string;
  future_policy_benefits : float nullable;
  future_policy_benefits_row : string nullable;
  claims_liability : float nullable;
  claims_liability_row : string nullable;
  reserves_to_premiums : float nullable;
  solvency : float nullable;          (* always null: RBC and Solvency II live in regulatory filings, not financial statements *)
  solvency_basis : string;
}

(* What the price needs to be true (12): two readouts solved by bisection on the record's
   own inputs with everything else held at its recorded value. [level] is the starting
   growth (dcf: implied_g0) or starting ROE (residual income: implied_roe0) at which fair
   value equals price; [half_life_years] is the reversion half-life (ln 2 / lambda) at
   which it does, holding the observed g0 or ROE0, attempted only when that start lies
   above its reversion target (fair value is monotone in lambda only there). A null carries
   its reason. [meaningful_readout] is decided by rule, never by hand: half_life above the
   target, level at or below it. The headline fair value does not depend on this block. *)
type readout = {
  value : float nullable;
  reason : string nullable;                   (* non-null iff value is null *)
}

type held_input = {
  name : string;
  value : float;
}

type implied = {
  level_name : string;                        (* implied_g0 | implied_roe0 *)
  level : readout;
  level_domain : float list;                  (* [low; high] *)
  half_life_years : readout;
  lambda_domain : float list;                 (* [low; high]; half-lives from ln 2 / high to ln 2 / low *)
  ?horizon_years : readout option;            (* (14) the smallest whole number of explicit years, holding the observed start, at which fair value reaches the price; integer scan over 1..40, only under the guard; absent on records from before it *)
  ~horizon_bracket : float list;              (* (14) fair value at N-1 and at N when solved; empty otherwise *)
  ?fair_value_at_40 : float option;           (* (14) fair value at a 40-year explicit period, under the guard; absent otherwise *)
  ~rf_tenor : string;                         (* (14) how the risk-free rate is treated across horizons *)
  meaningful_readout : string;                (* level | half_life | horizon (14) *)
  meaningful_rule : string;                   (* the comparison that decided it, with the numbers *)
  solver : string;                            (* bisection *)
  tolerance : float;                          (* on the solved variable *)
  held : held_input list;                     (* every input held at its recorded value *)
}

(* The REIT model (18): a dividend discount on the dividend FFO covers. FFO per NAREIT from
   filed tags (net income + real-estate depreciation and amortisation + impairments - gains
   on property sales); D0 = min(dividends, FFO) / effective shares, so an uncovered dividend
   is never valued; g0 = the CAGR of FFO per cover-page share over the filed periods,
   clamped and mean-reverting toward terminal growth as the DCF's growth does (the growth
   series divides each period's FFO by that period's weighted-average diluted count, per
   shares_for_flows; the level per share is on effective shares, per shares_for_market_cap);
   the cost of equity is CAPM with the REIT industry beta. Value = sum of D_t / (1 + ke)^t plus a Gordon
   terminal on D_N. AFFO is not derivable from tags: FFO overstates distributable cash by
   the recurring capex and non-cash rent the filer does not tag, which [caveat] says. *)
type reit_inputs = {
  fiscal_period_end : string;
  country : string;
  industry : string nullable;
  price : float;
  market_cap : float;
  shares : float;                     (* effective shares = market_cap / price *)
  ffo : float;
  ffo_composition : composition nullable;
  ffo_per_share : float;              (* ffo / shares *)
  price_to_ffo : float;
  dividends_paid : float;
  dividends_paid_row : string nullable;
  coverage : float;                   (* dividends_paid / ffo *)
  covered_dividend : float;           (* min (dividends_paid, ffo) *)
  dividend_per_share : float;         (* D0 = covered_dividend / shares *)
  ffo_per_weighted_share : (string * float) list <json repr="object">;   (* period end -> ffo / the period's weighted-average diluted shares, the growth series (19) *)
  weighted_shares_tags : (string * string) list <json repr="object">;     (* period end -> the count's tag *)
  ffo_periods : string list;          (* the periods the CAGR spans *)
  g_historical : float;               (* the FFO-per-share CAGR *)
  g0 : float;                         (* after the clamp *)
  growth_clamped : bool;
  growth_clamp_lower : parameter;
  growth_clamp_upper : parameter;
  mean_reversion_lambda : parameter;
  growth_path : float list;
  risk_free_rate : parameter;
  equity_risk_premium : parameter;
  ?country_risk_premium : parameter option;
  beta : parameter;
  beta_source : beta_source;
  cost_of_equity : float;
  ?conversion : conversion option;
  terminal_growth_rate : parameter;
  projection_years : int_parameter;
  dividend_path : float list;         (* D_1 .. D_N per share *)
  pv_dividends : float;
  terminal_value : float;             (* D_N (1 + g_T) / (ke - g_T), at N *)
  pv_terminal_value : float;
  equity_value : float;               (* per share: pv_dividends + pv_terminal_value *)
  caveat : string;
}

(* The inputs of whichever model ran, tagged with it. *)
(* One through-cycle return observation (22, 25): the period's NOPAT, bottom-up from filed
   lines (net income + interest expense x (1 - statutory tax rate); no operating-income line
   is needed, and the through-cycle mean is what dampens one-offs), over the invested capital
   (book equity + total debt - cash) at the end of the previous period. *)
type roic_observation = {
  period_end : string;
  prior_period_end : string;
  net_income : float;
  interest_expense : float;
  nopat : float;                      (* net_income + interest_expense * (1 - statutory tax rate) *)
  invested_capital_prior : float;     (* book_equity + total_debt - cash at prior_period_end *)
  roic : float;                       (* nopat / invested_capital_prior *)
}

(* A period the mid-cycle window could not use in one of its sums (27): dropped from that
   sum, named, and the guards count what remains. *)
type midcycle_exclusion = {
  period_end : string;
  sum : string;                       (* roic | reinvestment *)
  missing : string;                   (* the field the period lacks for that sum *)
}

(* The mid-cycle DCF (22): the DCF engine run on through-cycle earning power instead of
   the latest year's flow. [dcf] is the engine's own record on the mid-cycle flow: fcff =
   fcff_mid, g0 = roic_mid * reinvestment_rate_mid before the clamp, nopat = nopat_mid,
   roic and reinvestment_rate the mid-cycle ones, the tax rate statutory; ebit on it is the
   pre-tax equivalent of the latest period's bottom-up nopat (nopat / (1 - tax rate), recipe
   nopat_bottom_up), d&a, capex and delta_nwc the latest period's own (spot) values, recorded
   for spot_fcff, each null when the latest period lacks it (27), and its delta_nwc_periods
   is that one period when present. The latest period must carry the balance sheet only
   (required_on_latest_period in field_definitions.json). Everything else on [dcf] (parameters,
   wacc, path, terminal, net debt, shares) is exactly the DCF's. *)
type midcycle_inputs = {
  dcf : inputs;
  nopat_recipe : string;              (* nopat_bottom_up (25): net income + interest expense x (1 - statutory tax rate), per period *)
  midcycle_window_years : int_parameter;
  window : string list;               (* the fiscal period ends in the window, newest first: every annual period the record carries, up to midcycle_window_years *)
  observations : roic_observation list;   (* one per consecutive pair in the window with net income, interest expense and a positive prior invested capital; at least 8 *)
  ~exclusions : midcycle_exclusion list;  (* (27) every period dropped from a sum, with the field it lacked *)
  roic_mid : float;                   (* arithmetic mean of the observations' roic, the bad years included *)
  roic_median : float;                (* a readout beside it, not used *)
  invested_capital_latest : float;    (* the newest period's book_equity + total_debt - cash *)
  nopat_mid : float;                  (* roic_mid * invested_capital_latest *)
  reinvestment_periods : string list; (* the window periods with capex, d&a, delta_nwc, net income and interest expense, summed; at least 8 (27) *)
  reinvestment_sum : float;           (* sum over reinvestment_periods of capex - d&a + delta_nwc *)
  nopat_sum : float;                  (* sum over reinvestment_periods of nopat_t *)
  reinvestment_rate_mid : float;      (* reinvestment_sum / nopat_sum: sums, never a mean of ratios *)
  fcff_mid : float;                   (* nopat_mid * (1 - reinvestment_rate_mid) *)
  spot_fcff : float nullable;         (* the latest period's own fcff at the same tax rate; a readout, null with spot_reason when the latest period lacks a flow (27) *)
  spot_to_midcycle : float nullable;  (* spot_fcff / fcff_mid: how far off-cycle the current year is *)
  ?spot_reason : string option;
}

type model_inputs = [
  | Dcf <json name="dcf"> of inputs
  | Dcf_midcycle <json name="dcf_midcycle"> of midcycle_inputs
  | Residual_income <json name="residual_income"> of residual_income_inputs
  | Residual_income_insurer <json name="residual_income_insurer"> of insurer_inputs
  | Reit_ffo_dividend <json name="reit_ffo_dividend"> of reit_inputs
]

(* Sensitivity (23): the anchor re-evaluated at each held input stepped down and up by a
   declared readability step, everything else at its recorded value. Deterministic; no
   distribution, no sampling; the steps are not standard deviations. *)
type sensitivity_entry = {
  input : string;                     (* the held input's name *)
  recorded : float;
  step : float;                       (* the declared step: absolute for a rate, a fraction of the recorded value for the base *)
  step_kind : string;                 (* absolute | relative *)
  down : readout;                     (* fair value at recorded - step; null with reason when the step crosses a guard *)
  up : readout;                       (* fair value at recorded + step *)
  swing : float nullable;             (* |up - down| / fair_value; null iff a side is null *)
}

type sensitivity = {
  fair_value : float;                 (* the anchor the swings are measured against *)
  steps_source : string;              (* provenance of the steps, from reference/params.json *)
  steps_as_of : string;
  entries : sensitivity_entry list;   (* in the held order *)
  ranking : string list;              (* inputs with a swing, largest first *)
  binding_input : string nullable;    (* the first of ranking; null when no entry has a swing *)
  note : string;                      (* what the block says and does not say *)
}

(* The belief map (23): the plain-language readout model, distinct from the headline's
   decaying path and stated as such: growth held at g for N years with no decay, then the
   settled terminal growth forever, everything else at its recorded value. *)
type contour_point = {
  years : int;
  growth : readout;                   (* the g at which fair value equals price; null with reason when no g in the domain reaches it *)
}

type belief_map = {
  map_model : string;                 (* "undecayed growth for N years, then terminal" *)
  base_name : string;                 (* fcff | fcff_mid | dividend_per_share *)
  base : float;                       (* the cash-flow base the growth compounds from *)
  rate_name : string;                 (* wacc | cost_of_equity *)
  rate : float;
  terminal_growth_rate : float;
  net_debt : float;                   (* 0 on a per-share base *)
  shares : float;                     (* 1 on a per-share base *)
  observed_growth : float;            (* the record's g0 *)
  growth_domain : float list;         (* [0; 0.5] *)
  growth_step : float;                (* 0.02: the grid's step *)
  horizon_max : int;                  (* 40 *)
  price_contour : contour_point list; (* one per N = 1..40 *)
  solver : string;
  tolerance : float;
}

(* The whole grid, written to output/maps/(ticker).json (23), never onto the record. *)
type belief_grid = {
  ticker : string;
  map_model : string;
  price : float;
  observed_growth : float;
  growth_grid : float list;           (* 0, 0.02 .. 0.5 *)
  horizon_grid : int list;            (* 1 .. 40 *)
  fair_values : float list list;      (* one row per growth, one column per horizon *)
  price_contour : contour_point list;
}

(* The declared belief (24) as resolved for the record: the six fields, in decimal
   fractions of long-run nominal growth. Carried beside the probability so the number
   never travels without its basis. *)
type belief = {
  mean : float;
  sd : float;
  floor : float;
  ceiling : float;
  why : string;
  as_of : string;
}

type belief_readout = {
  declared : belief;
  source : string;                    (* class default (offsets around the country's terminal growth) or a per-name entry *)
  belief_version : string;            (* the belief's as_of, a short hash of its six fields, and class or name *)
  implied_terminal_growth : readout;  (* the fourth readout: the long-run growth at which fair value equals price on the headline's decaying path, everything else held; null with reason past either end of implied_domain *)
  implied_domain : float list;        (* [-0.10; discount rate - 0.0005] *)
  probability_overpaid : float;       (* P(long-run growth < implied) under the belief: the probability that the value surplus is negative; 1 or 0 with probability_reason when the implied readout is null *)
  ?probability_reason : string option;
  value_surplus : float;              (* the margin of safety: (fair value - price) / price, the book's value surplus *)
  note : string;
}

type valuation = {
  ticker : string;
  as_of : string;                     (* the fetch timestamp, from financials *)
  valued_on : string;                 (* ISO 8601 date parameter ages are measured at *)
  ~model_version : string;            (* the code that produced the record: git short hash, "-dirty" when the tree had uncommitted edits, "unversioned" outside a checkout (21); empty only on records written before it existed *)
  currency : string nullable;         (* basis of price and fair_value *)
  price : float nullable;
  fair_value : float nullable;        (* per share *)
  margin_of_safety : float nullable;  (* (fair_value - price) / price *)
  signal : signal nullable;
  entity_class : entity_class nullable;   (* as declared; null iff not declared *)
  model : model nullable;                 (* the model the record was routed to *)
  class_check : class_check nullable;
  floor : floor;
  scope_limits : string list;             (* what the models cannot see for this name, verbatim from the declaration *)
  statements_provider : string;           (* the provider decision, on every record *)
  ~taxonomy : string;                     (* us-gaap | ifrs-full on filed statements; empty otherwise (13) *)
  market_provider : string;
  provider_reason : string;
  ?filing_age_days : int option;          (* valued_on - latest_filing, when the statements are filed ones *)
  ?cross_check : cross_check option;      (* carried verbatim from the record *)
  ?submissions_latest_annual : submission option;   (* carried verbatim from the record (14) *)
  ?point_in_time : point_in_time option;            (* from the record, anachronistic_inputs filled (17) *)
  status : status;
  failed_reason : string nullable;
  inputs : model_inputs nullable;
  ?implied : implied option;              (* present iff status is Ok (12) *)
  ?sensitivity : sensitivity option;      (* present iff status is Ok (23) *)
  ?belief_map : belief_map option;        (* present on an Ok record with a growth-then-terminal structure: dcf, dcf_midcycle, reit_ffo_dividend (23) *)
  ?belief_map_reason : string option;     (* present instead on an Ok record without one: the residual-income paths (23) *)
  ?belief_version : string option;        (* (24) on every Ok record that used a belief; absent (null) on a run without one for the name *)
  ?belief : belief_readout option;        (* (24) present iff belief_version is *)
  ?belief_reason : string option;         (* (24) why an Ok record has no belief: the residual-income path, or no declaration for the class or name *)
}
