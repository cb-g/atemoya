(* The boundary between Python (vendor ingestion) and OCaml (valuation).

   This file is the only definition of the wire types. atdgen generates the OCaml side
   (Boundary_t, Boundary_j) at build time; atdpy generates python/boundary.py, which dune
   promotes into the source tree. Neither side hand-writes these types.

   Contract for [financials] (Python -> OCaml):
   - Every money field is an absolute amount (not thousands or millions) in [currency].
     If no single currency basis could be established, [currency] is null and the
     valuation must fail rather than guess.
   - A null field means the vendor supplied nothing usable. Never a substituted value.
   - No NaN or infinity crosses the boundary in either direction.
   - [periods] are annual fiscal periods, most recent first. A period in which every
     statement field is null is omitted.
   - [country] and [industry] are the vendor's strings, used only as lookup keys into
     reference/ and, for [industry], as a hint that may fail a classification but never
     make one. Null when the vendor supplied nothing.

   Contract for [valuation] (OCaml -> consumers): one record per ticker. [fair_value],
   [margin_of_safety] and [signal] are non-null iff [status] is [Ok]; [failed_reason] is
   non-null iff [status] is [Failed]; [entity_class] is the human declaration and is null
   iff none was made; [model] is the model the record was routed to and is null when no
   model was admissible for the class or routing failed before one was chosen;
   [class_check] is null iff the signature threshold parameter could not be resolved;
   [inputs] is non-null iff a model's arithmetic ran to completion, which includes a
   valuation that then failed a sanity check, and is tagged with the model that produced
   it. A model never runs on a class the admissibility table does not admit it for. [floor] is always present with a non-empty basis and gates
   nothing here. Every parameter carries its value, lookup key, source, as_of and age in
   days measured at [valued_on], so "where did this number come from" is answerable from
   the record alone. *)

(* How a defined field was assembled: the definition it follows (its name in
   reference/field_definitions.json, or for ebit the recipe) and the components summed,
   each with the provider's row label or us-gaap tag. Money in the record's currency. *)
type component = {
  name : string;                              (* the component's name in the definition, e.g. "cash_equivalents" *)
  value : float;                              (* as summed: sign already applied *)
  row : string;                               (* the row label or tag that supplied it *)
}

type composition = {
  definition : string;
  components : component list;
}

(* (61) A later filing carries this fiscal period with a different value for a tag the
   record reads. The value taken is always the one from the filing whose own fiscal year
   the period is, because that filing presents the year under the tags the filer used
   then and its component set is internally consistent; a later filing's comparative
   column is regrouped to the later year's presentation, and mixing the two is the double
   count this rule exists to stop. The later value is recorded and never used: a
   restatement is a finding, and which of the two a reader should believe is a judgement
   this tool does not make for them. *)
type restatement = {
  tag : string;
  taken : float;                 (* the own-year filing's value, which the record uses *)
  later : float;                 (* the later filing's value for the same period *)
  accession : string;            (* the later filing *)
  filed : string;                (* its filing date *)
}

type fiscal_period = {
  period_end : string;                        (* ISO 8601 date, fiscal year end *)
  ebit : float nullable;                      (* operating income, else pretax income + interest expense (ebit_recipe says which); any sign *)
  pretax_income : float nullable;             (* any sign *)
  tax_provision : float nullable;             (* income tax expense; negative = benefit *)
  total_revenue : float nullable;             (* >= 0 *)
  net_interest_income : float nullable;       (* any sign; the vendor reports it for every company *)
  premiums_earned : float nullable;           (* >= 0; insurers only, when the vendor exposes a premium row *)
  premiums_earned_row : string nullable;      (* the vendor's row label that supplied premiums_earned *)
  depreciation_amortization : float nullable; (* >= 0; non-cash add-back, depletion included where the vendor bundles it *)
  depreciation_amortization_row : string nullable;  (* the vendor's row label that supplied it *)
  capex : float nullable;                     (* capital expenditure; >= 0 = cash spent *)
  delta_nwc : float nullable;                 (* the cash-flow statement's change in operating working capital; > 0 = cash absorbed *)
  cash : float nullable;                      (* cash and equivalents plus short-term investments, restricted cash excluded; >= 0 *)
  total_debt : float nullable;                (* financial debt, operating leases excluded; >= 0; never a substituted zero *)
  total_debt_source : string nullable;        (* the vendor row or row sum that supplied it *)
  book_equity : float nullable;               (* total stockholders' equity at period end; any sign *)
  net_income : float nullable;                (* any sign *)
  dividends_paid : float nullable;            (* >= 0; cash dividends paid in the period *)
  dividends_paid_row : string nullable;
  ?operating_cash_flow : float option;        (* (76) the cash-flow statement's net cash from operating activities, as filed or as the vendor reports it; any sign *)
  ?operating_cash_flow_row : string option;   (* the tag or row it came from *)
  provision_for_credit_losses : float nullable;   (* >= 0; the vendor exposes no such row on any bank probed (2026-09-18) *)
  provision_for_credit_losses_row : string nullable;
  net_loans : float nullable;                 (* >= 0; banks only *)
  net_loans_row : string nullable;
  (* Present only when the provider is filed statements (optional fields: omitted otherwise). *)
  ?filed : string option;                     (* filing date of the statement this period came from *)
  ~restated_from : restatement list;          (* (61) empty unless a later filing disagrees on a tag the record reads *)
  ?no_distributions_filed : bool option;   (* (65) present and true only where the filing carries the cash-flow statement's financing subtotal and no dividend or distribution element at all: the filing saying it paid none, which an absent tag alone cannot say *)
  ?working_capital_reconciled : bool option;  (* (61) whether the filed operating section adds up as this tool reads it: net income, the adjustments the table names, and this period's working-capital change against the filed operating cash flow. A pointer for a reader and never a gate: false can mean an adjustment tag the table does not name rather than a wrong working-capital number *)
  ?working_capital_gap : float option;        (* (61) the residual when it does not close, in the statement's currency *)
  ?accession : string option;
  ?aoci : float option;                       (* accumulated other comprehensive income, net of tax; any sign *)
  ?aoci_row : string option;
  ?aoci_recipe : string option;               (* filed | sum_of_components (31) *)
  ?aoci_composition : composition option;     (* the components summed, when the recipe is sum_of_components (31) *)
  ?interest_recipe : string option;           (* filed | net_nonoperating_interest | interest_paid_stands_in (31): how interest_expense was obtained; read by the mid-cycle model only *)
  ?claims_incurred : float option;            (* >= 0; policyholder benefits and claims incurred *)
  ?claims_incurred_row : string option;
  ?benefits_losses_and_expenses : float option;   (* >= 0; the total including acquisition and operating expense *)
  ?benefits_losses_and_expenses_row : string option;
  ?policy_acquisition_expense : float option; (* >= 0 *)
  ?policy_acquisition_expense_row : string option;
  ?operating_expense : float option;          (* >= 0 *)
  ?operating_expense_row : string option;
  ?future_policy_benefits : float option;     (* >= 0; liability at period end *)
  ?future_policy_benefits_row : string option;
  ?claims_liability : float option;           (* >= 0; liability at period end *)
  ?claims_liability_row : string option;
  (* The row (tag) that supplied each core field when the provider records one. *)
  ?total_revenue_row : string option;
  ?ebit_row : string option;
  ?pretax_income_row : string option;
  ?tax_provision_row : string option;
  ?capex_row : string option;
  ?delta_nwc_row : string option;
  ?cash_row : string option;
  ?book_equity_row : string option;
  ?net_income_row : string option;
  ?net_interest_income_row : string option;
  (* The definition each composed field follows and the components summed (11). *)
  (* REIT (18): funds from operations per the definition, filed statements only. *)
  ?ffo : float option;
  ?ffo_composition : composition option;
  (* (59) A business development company's three filed lines. Optional, so no other
     filer's period carries them: the net asset value per share the filing states, the
     net investment income that is meant to cover the distribution, and the distribution
     the filer declared per share. *)
  ?net_asset_value_per_share : float option;
  ?net_asset_value_per_share_row : string option;   (* the tag, or "net assets / shares outstanding" naming both *)
  ?net_asset_value_composition : composition option;
  ?net_investment_income : float option;
  ?net_investment_income_row : string option;
  ?net_investment_income_composition : composition option;
  ?distributions_per_share : float option;
  ?distributions_per_share_row : string option;
  ?ffo_unavailable : string option;           (* (54) why the definition left ffo null when the reason is structural, not a missing tag: the REIT model fails with this string instead of naming the absent field *)
  ?weighted_shares : float option;            (* the period's weighted-average diluted (else basic) share count, the only count a flow per share may use (19) *)
  ?weighted_shares_tag : string option;
  ?ebit_recipe : string option;               (* "operating_income" | "pretax_plus_interest" *)
  ?ebit_composition : composition option;
  ?ebit_alternative : float option;            (* the third recipe beside a derived ebit: revenues less the filer's total costs and expenses, plus interest expense where it is inside those costs; read by the EBIT policy only when the derived figure misses the cross-check *)
  ?ebit_alternative_composition : composition option;
  ?interest_expense : float option;           (* the filed interest expense line, first present of the ebit definition's tags or vendor rows (25); the mid-cycle model's bottom-up NOPAT reads it *)
  ?interest_expense_row : string option;
  ?depreciation_amortization_candidates : component list option;   (* (27) every D&A total tag filed for the period with its value; depreciation_amortization_row names the largest, taken *)
  ?depreciation_amortization_recipe : string option;               (* (32) ifrs: pure | inclusive_less_impairment | total *)
  ?depreciation_amortization_composition : composition option;     (* (32) the inclusive figure, the impairment subtracted and the reversal added back, each with its tag *)
  ?cash_composition : composition option;
  ?total_debt_composition : composition option;
  ?delta_nwc_composition : composition option;
  (* (69) The common-only side of the filing, for the residual-income path alone. Residual
     income values COMMON equity, and preferred stock is a claim senior to it: its dividends
     are not the common holder's income and its carrying value is not the common holder's
     book. Nothing outside that path reads any of these, and the fields the rest of the tool
     reads -- net_income, book_equity, dividends_paid -- are untouched. *)
  ?net_income_to_common : float option;       (* the filed available-to-common figure; any sign. It nets out participating-security allocations as well as preferred dividends, so it can differ from net income on a filer with no preferred at all *)
  ?net_income_to_common_row : string option;
  ?preferred_equity : float option;           (* >= 0; the preferred carrying value INSIDE stockholders' equity, first of the carrying tags filed. A par-value line of zero is not a carrying value and does not resolve *)
  ?preferred_equity_row : string option;
  ?preferred_dividends : float option;        (* >= 0; declared or paid, the tag recorded. Its presence is what says a filer HAS preferred, which a zero carrying value cannot *)
  ?preferred_dividends_row : string option;
  ?preferred_outside_equity : bool option;    (* (69) true where the filer tags redeemable preferred: mezzanine equity, never inside stockholders' equity, so the common book needs no deduction and taking one would double-count *)
  ?common_dividends_paid : float option;      (* >= 0; the filed common-dividend element, else dividends_paid less preferred_dividends, the recipe recorded *)
  ?common_dividends_paid_row : string option;
}

(* One canonical field compared between the statements provider and the cross-check
   provider for the latest common period. Recorded, never a gate, never resolved. *)
type field_check = {
  field : string;
  primary : float nullable;
  secondary : float nullable;
  relative_difference : float nullable;   (* |primary - secondary| / max(|primary|, |secondary|); null unless both present *)
  agree : bool nullable;                  (* relative_difference <= threshold; null unless both present *)
}

type cross_check = {
  provider : string;                      (* the cross-check provider *)
  ~source : string;                       (* point-in-time (19): "live vendor statements, same fiscal period, fetched after D"; empty on a live record *)
  period_end : string;                    (* the primary's period *)
  secondary_period_end : string;          (* the cross-check provider's matching period *)
  threshold : float;
  fields : field_check list;
  disagreements : int;                    (* fields with agree = false *)
}

(* Whether the vendor quoted the price in the currency's major unit or a minor one (pence,
   cents, agorot). The fetch converts to the major unit and records the divisor. *)
type price_unit = [ Major <json name="major"> | Minor <json name="minor"> ]

(* The newest annual filing SEC's submissions index lists for the filer (14): an
   observable independent of companyfacts. When it is newer than the newest annual facts
   and those facts are past the filing-age gate, the vendor's statements are used and the
   provider_reason says so; the decision is on the record, never a fallback from the gate. *)
type submission = {
  form : string;                 (* 10-K | 20-F *)
  filing_date : string;
  accession : string;
  report_date : string;          (* the fiscal period end the filing reports *)
}

(* Point-in-time (17): the record was assembled as of a past date [as_of_date] with only
   what was known then: facts filed on or before it, the close on the last trading day on
   or before it (the vendor's split-adjusted close multiplied by every split after that
   day), shares from the newest cover page filed by then, rates and FX observed on or
   before it. The valuation fills [anachronistic_inputs] with every parameter whose vintage
   postdates the date (ERP, tax, betas and the assumptions are held at the current vintage,
   declared, never hidden) and refuses the record when no filed statements, shares or rate
   history were available on the date. *)
type point_in_time = {
  as_of_date : string;
  ?price_date : string option;               (* the last trading day on or before as_of_date *)
  ?close_as_served : float option;           (* the vendor's close for that day, split-adjusted as served *)
  ?split_factor : float option;              (* product of the split ratios dated after as_of_date; price = close x factor *)
  ~shares_source : string;                   (* "dei cover page" *)
  ?shares_tag : string option;
  ?shares_as_of : string option;             (* the cover page's own date *)
  ?shares_filed : string option;
  ?shares_period_end : string option;        (* (44) the newest filed period the count serves *)
  ?shares_split_factor : float option;       (* (44) the product of the vendor's split ratios dated after the count's date and on or before as_of_date; the count is multiplied by it, as prices are corrected *)
  ?split_record : string option;             (* (44) "split record: 2.0 on 2025-09-08" or "split record: none between <count date> and <D>" *)
  ?shares_ordinary : float option;           (* (42) the filed count before division by the receipt ratio, after the split adjustment; present iff adr_ratio is declared *)
  ?adr_ratio : float option;                 (* (42) ordinary shares per receipt, as declared on the universe entry *)
  ~rate_observations : (string * string) list <json repr="object">;   (* series -> observation date used *)
  ~anachronistic_inputs : string list;       (* filled by the valuation: "name (vintage as_of)" *)
  ?statements_unavailable : string option;   (* why no filed statements were available on the date *)
  ?shares_unavailable : string option;
  ?rates_unavailable : string option;        (* the currency whose rate source offers no history *)
}

type financials = {
  ticker : string;
  as_of : string;                (* ISO 8601 UTC timestamp of the fetch *)
  currency : string nullable;    (* ISO 4217; the single basis of every money field when statements and price agree; null otherwise *)
  financial_currency : string nullable;   (* what the statements are in *)
  trading_currency : string nullable;     (* what the price and market cap are in, major unit *)
  price_unit : price_unit;       (* how the vendor quoted the price *)
  price_unit_divisor : float;    (* 1 for major; the minor-unit divisor already applied to the price *)
  price : float nullable;        (* last price per share in trading_currency, major unit; > 0 *)
  market_cap : float nullable;   (* in trading_currency; > 0 *)
  country : string nullable;     (* domicile as the vendor spells it, e.g. "United States" *)
  industry : string nullable;    (* industry as the vendor spells it, e.g. "Consumer Electronics" *)
  periods : fiscal_period list;
  notes : string list;           (* free-text provenance and data-quality notes; never branched on *)
  ~provider : string;            (* the statements provider, e.g. "yfinance" or "SEC XBRL companyfacts" *)
  ~taxonomy : string;            (* filed statements only: us-gaap | ifrs-full; empty on vendor statements (13) *)
  ?vendor_financial_currency : string option;   (* filed statements only: the vendor's statement currency, which must agree with financial_currency (the filing's unit) (13) *)
  ~market_provider : string;     (* where price, market cap and currencies came from; always the vendor feed *)
  ~provider_reason : string;     (* why this statements provider was chosen *)
  ~statements_unavailable : string;   (* why the provider had no statements for this ticker; empty when it had *)
  ~rd_history : rd_year list;         (* the filed annual research and development expense, newest first, up to twelve fiscal years, in financial_currency; empty with the reason below *)
  ?rd_history_reason : string option; (* why rd_history is empty: no filed facts, or no research and development line in them *)
  ?identity_mismatch : string option; (* the ticker no longer names the filer the universe entry declared (map_cik); the record is refused before anything else *)
  ?latest_filing : string option;     (* ISO date of the newest annual filing the statements come from *)
  ?cross_check : cross_check option;  (* the vendor's statements compared with the filed ones *)
  ?submissions_latest_annual : submission option;   (* every CIK-resolved record (14); absent with the reason below *)
  ?submissions_unavailable : string option;         (* why submissions_latest_annual is absent (14) *)
  ?point_in_time : point_in_time option;            (* present iff the record is a point-in-time one (17) *)
  ?cover_page_shares : float option;                (* (42) the newest cover-page count filed by the fetch date, ordinary shares, for the receipt-ratio check; absent on records fetched before it existed or without a filer *)
  ?cover_page_shares_tag : string option;
  ?cover_page_shares_as_of : string option;
  ?cover_page_split_factor : float option;          (* (44) the product of the vendor's split ratios after the cover page's date up to the fetch date; the check multiplies the count by it *)
  ?cover_page_split_record : string option;
  ?stretch : stretch option;                        (* (52) present when the name has 250 trading days of closes on or before the date *)
  ?insiders : insiders option;                      (* (66) present on a CIK-resolved name with Form 4 filings in the year to the date *)
  ?insiders_reason : string option;                 (* (66) present instead: why there is none *)
  ?stretch_reason : string option;                  (* (52) why not: price history shorter than 250 trading days *)
  ?earnings_calendar : earnings_calendar option;    (* (68) the filed or vendor release calendar; the implied half needs the options store and is added at the valuation *)
  ?earnings_calendar_reason : string option;        (* (68) present instead: why there is no calendar *)
}

(* Closed variants: consumers must match every constructor. *)

(* The valuation models that exist. A model runs only where reference/admissibility.json
   lists it for the declared entity class. *)
type model = [
  | Dcf <json name="dcf">                             (* FCFF DCF; OperatingCompany *)
  | Residual_income <json name="residual_income">     (* excess returns over book; Bank *)
  | Residual_income_insurer <json name="residual_income_insurer">   (* excess returns over AOCI-adjusted book; Insurer *)
  | Reit_ffo_dividend <json name="reit_ffo_dividend">   (* the FFO-covered dividend discounted at the cost of equity; Reit (18) *)
  | Dcf_midcycle <json name="dcf_midcycle">           (* the FCFF DCF on through-cycle earning power; Cyclical (22) *)
  | Bdc_nav <json name="bdc_nav">                     (* the filed net asset value per share, with the coverage of the distribution beside it; Bdc (59) *)
]

(* What a company is judged on: a controlled vocabulary of economic drivers, not sectors.
   Declared by a human in reference/universe.json (or on the command line), never inferred.
   Anything else gets a constructor added here, not shoehorned into OperatingCompany. *)
type entity_class = [
  | OperatingCompany     (* FCFF-based DCF; positive, stable free cash flow, no structural break *)
  | Bank                 (* price/book against ROE, loan-loss provisioning coverage as the check *)
  | Insurer              (* operating-profit multiple read with the solvency ratio *)
  | RegulatedUtility     (* rate-base growth and authorised ROE vs own operating EPS guidance *)
  | MerchantPower        (* EV/EBITDA and pre-growth FCF vs the earnings build, by clearing price *)
  | Reit                 (* price/AFFO, dividend coverage by AFFO; never accounting EPS *)
  | Miner                (* NAV and reserve life; never spot FCF *)
  | Royalty              (* NAV of the royalty book; AISC is inverted for this class *)
  | HighGrowthSoftware   (* recurring revenue growth, retention, margin path *)
  | Unprofitable         (* no history of profit to normalise from: cash runway vs the catalyst calendar; no multiple applies (was PreProfit, renamed 22) *)
  | Cyclical             (* earnings set by a commodity price or an industry cycle the company does not control: through-cycle return on today's capital (22) *)
  | Wrapper              (* NAV premium/discount plus distribution by source *)
  | Bdc                  (* a business development company (59): the filed net asset value per share, and whether net investment income covers the distribution *)
  | ConstructionStage    (* percent complete, distance to first production, debt paydown *)
  | UnderBid             (* the announced offer price; all other valuation suspended *)
  | Ballast              (* nothing; held as a hedge, no directional thesis *)
  | HoldingCompany       (* parts that need different lenses under one set of statements (81): the sum of the parts, each on its own class's lens *)
]
type status = [ Ok | Failed ]
type signal = [ Buy | Hold | Sell ]
type tax_rate_source = [ Effective | Statutory ]
type beta_source = [
  | Industry_table <json name="industry_table">
  | Default_no_industry <json name="default_no_industry">
]
type growth_source = [
  | Fundamental <json name="fundamental">                            (* roic * reinvestment rate *)
  | Historical_capped_at_roic <json name="historical_capped_at_roic"> (* revenue CAGR, held to roic *)
  | Historical <json name="historical">                              (* revenue CAGR *)
]

(* How a cross-currency record was converted: every statement total was multiplied by
   [fx_rate] (trading currency per unit of financial currency, through USD) before the
   model ran; the discount rate and terminal growth are the trading currency's country's,
   the tax rate the domicile's. Present only on the cross-currency path. *)
type conversion = {
  financial_currency : string;
  trading_currency : string;
  fx_rate : float;                  (* trading per financial *)
  fx_usd_per_financial : float;
  fx_usd_per_trading : float;
  fx_source : string;
  fx_as_of : string;
  fx_age_days : int;
  domicile : string;
  rate_country : string;            (* risk-free rate and terminal growth *)
  growth_country : string;
  price_unit : price_unit;
  price_unit_divisor : float;
}

(* A parameter as used, with its provenance. *)
type parameter = {
  value : float;
  key : string;          (* lookup key: "United States", "United States/7y", "Consumer Electronics", "global" *)
  source : string;
  as_of : string;        (* ISO 8601 date of the source value *)
  age_days : int;        (* valued_on - as_of *)
  ~estimated : bool;     (* the source marks this cell as an interpolation, not a quote *)
  ~tier : string;        (* risk-free only: official | fred_oecd_10y | manual *)
  ~tenor_requested : string;   (* risk-free only: the tenor the horizon asked for *)
  ~tenor_used : string;        (* risk-free only: the tenor supplied; differs on a recorded substitution *)
}

type int_parameter = {
  value : int;
  key : string;
  source : string;
  as_of : string;
  age_days : int;
}

(* The statement signatures, read as a consistency check against the declared class.
   They never decide the class. *)
type class_check_outcome = [
  | Consistent          (* a signature fired and matches the declaration, or nothing contradicts it *)
  | Signature_absent    (* declared a class the statements can signal, and they did not *)
  | Signature_differs   (* a signature fired for another class; harmless, no inadmissible model could run *)
  | Disagreement        (* fatal: declared OperatingCompany, statements indicate a class the dcf is not admissible for *)
  | Undeclared          (* fatal: no entity_class declared *)
]

type class_check = {
  declared : entity_class nullable;
  indicated : entity_class nullable;      (* what the statements indicate: Bank, Insurer, or null *)
  outcome : class_check_outcome;
  fiscal_period_end : string nullable;    (* the period read; null when there are no periods *)
  total_revenue : float nullable;
  net_interest_income : float nullable;
  nii_ratio : float nullable;             (* net_interest_income / total_revenue; null unless both present and revenue > 0 *)
  bank_nii_ratio_threshold : parameter;   (* the statements indicate Bank iff nii_ratio >= this *)
  premiums_earned : float nullable;       (* the statements indicate Insurer iff > 0, unless Bank *)
  premiums_earned_row : string nullable;
}

(* Whether there is something under the price, and on what basis. Never gates anything
   in this tool; position sizing is the consumer's decision. *)
type floor = {
  present : bool nullable;   (* true: a model verified it; false: the class has none by definition; null: not assessable here *)
  basis : string;            (* what established it, or what would; never empty *)
}

(* Every value the valuation used, plus the intermediates, for audit. Money in
   [valuation.currency]; rates are decimal fractions per year. Growth is derived from the
   statements and never a constant: [g0] is the selected starting growth after the clamp,
   [growth_path] the yearly rates that mean-revert from it toward [terminal_growth_rate]. *)
type inputs = {
  fiscal_period_end : string;
  country : string;                   (* as fetched; each parameter's key is the canonical form *)
  industry : string nullable;
  price : float;
  market_cap : float;
  shares : float;                     (* effective shares = market_cap / price *)
  ebit : float nullable;              (* null only on the mid-cycle path when the latest period lacks the lines its spot nopat needs (27) *)
  ?ebit_recipe : string option;       (* operating_income | pretax_plus_interest; omitted on a record fetched before the definitions *)
  ?ebit_composition : composition option;
  tax_rate : float;                   (* the rate applied *)
  tax_rate_source : tax_rate_source;
  statutory_tax_rate : parameter;     (* the country's rate, applied iff tax_rate_source = Statutory *)
  nopat : float;                      (* ebit * (1 - tax_rate) *)
  depreciation_amortization : float nullable;   (* null only on the mid-cycle path when the latest period lacks the flow (27) *)
  depreciation_amortization_row : string nullable;
  capex : float nullable;             (* likewise *)
  delta_nwc : float nullable;         (* mean over delta_nwc_periods; likewise *)
  delta_nwc_periods : string list;    (* the fiscal periods averaged, at least 2 on the dcf *)
  ~delta_nwc_compositions : composition nullable list;   (* one per averaged period, in the same order; empty before the definitions *)
  fcff : float;                       (* nopat + d&a - capex - delta_nwc *)
  cash : float;
  ?cash_composition : composition option;
  total_debt : float;
  total_debt_source : string nullable;
  ?total_debt_composition : composition option;
  net_debt : float;                   (* total_debt - cash *)
  book_equity : float;
  invested_capital : float;           (* book_equity + total_debt *)
  roic : float nullable;              (* nopat / invested_capital; null iff invested_capital <= 0 *)
  reinvestment : float;               (* capex + delta_nwc - d&a *)
  reinvestment_rate : float nullable; (* reinvestment / nopat; null iff nopat <= 0 *)
  g_fundamental : float nullable;     (* roic * reinvestment_rate; null when either is *)
  g_historical : float nullable;      (* revenue CAGR over revenue_periods; null with fewer than 3 *)
  revenue_periods : string list;      (* the fiscal periods the CAGR spans *)
  growth_source : growth_source;
  g0 : float;                         (* starting growth, after the clamp *)
  growth_clamped : bool;              (* the clamp changed the selected growth *)
  growth_clamp_lower : parameter;
  growth_clamp_upper : parameter;
  mean_reversion_lambda : parameter;
  growth_path : float list;           (* g_1 .. g_N: terminal + (g0 - terminal) * exp(-lambda * t) *)
  risk_free_rate : parameter;         (* tenor matches projection_years *)
  equity_risk_premium : parameter;    (* the domicile's total ERP; on the cross-currency path the mature-market base *)
  ?country_risk_premium : parameter option;   (* cross-currency only: domicile total ERP less the mature-market base *)
  beta : parameter;
  beta_source : beta_source;
  cost_of_equity : float;             (* risk_free_rate + beta * equity_risk_premium (+ country_risk_premium) *)
  ?conversion : conversion option;    (* cross-currency only *)
  debt_spread : parameter;
  cost_of_debt : float;               (* pre-tax; risk_free_rate + debt_spread *)
  wacc : float;
  terminal_growth_rate : parameter;
  projection_years : int_parameter;
  enterprise_value : float;
  equity_value : float;               (* enterprise_value - net_debt *)
}

(* Every value the residual-income model used, plus the intermediates. Fair equity value
   = book value today + PV of excess returns (ROE_t - cost of equity) x start-of-year book
   over the explicit years, with ROE mean-reverting toward the cost of equity and book
   compounding by retained earnings. There is no terminal: ROE has reverted to the cost of
   equity by then, and growth at the cost of equity is value neutral, so book growth beyond
   the explicit years is worth nothing without an excess return (15). Never an earnings
   multiple, anywhere. The loan-loss ratios are recorded for the reader and gate nothing. *)
type residual_income_inputs = {
  fiscal_period_end : string;
  country : string;
  industry : string nullable;
  price : float;
  market_cap : float;
  shares : float;                     (* effective shares = market_cap / price *)
  book_equity : float;                (* latest period; > 0 *)
  book_value_per_share : float;
  net_income : float;                 (* latest period *)
  roe_0 : float;                      (* mean of net_income / book_equity over roe_periods *)
  roe_periods : string list;          (* at least 2 *)
  payout_ratio : float;               (* mean of dividends_paid / net_income over payout_periods, clamped to [0, 1] *)
  retention : float;                  (* 1 - payout_ratio; buybacks are not payout here *)
  payout_periods : string list;       (* at least 2, or empty under the filed-none rule (65) *)
  ~payout_source : string;            (* (65) empty where the ratio is the mean above; otherwise why retention is what it is *)
  dividends_paid : float nullable;    (* latest period *)
  dividends_paid_row : string nullable;
  risk_free_rate : parameter;
  equity_risk_premium : parameter;    (* the domicile's total ERP; on the cross-currency path the mature-market base *)
  ?country_risk_premium : parameter option;   (* cross-currency only *)
  beta : parameter;
  beta_source : beta_source;
  cost_of_equity : float;             (* risk_free_rate + beta * equity_risk_premium (+ country_risk_premium) *)
  ?conversion : conversion option;    (* cross-currency only *)
  mean_reversion_lambda : parameter;
  projection_years : int_parameter;
  roe_path : float list;              (* ROE_1 .. ROE_N: ke + (roe_0 - ke) * exp(-lambda * t) *)
  book_value_path : float list;       (* start-of-year book for years 1 .. N *)
  excess_return_path : float list;    (* (ROE_t - ke) * book at start of t *)
  pv_excess_returns : float;
  equity_value : float;               (* book_equity + pv_excess_returns *)
  justified_price_to_book : float;    (* equity_value / book_equity *)
  net_interest_income : float nullable;
  provision_for_credit_losses : float nullable;
  provision_for_credit_losses_row : string nullable;
  provision_to_net_interest_income : float nullable;
  net_loans : float nullable;
  net_loans_row : string nullable;
  provision_to_net_loans : float nullable;
  (* (69) Which basis the whole record ran on. Residual income values common equity, so
     income, book and retention are common-only where the filing supports all three; where
     it does not, every one of them stays on the total-equity basis and this says why.
     They never mix: common income over total book is neither reading. *)
  ~common_basis : string;                     (* common | total *)
  ~common_basis_why : string;                 (* what the filing did or did not support *)
  ?preferred_equity : float option;           (* the carrying value deducted from book, when one was *)
  ?preferred_equity_row : string option;
  ?preferred_dividends : float option;        (* the latest period's, recorded whether or not the basis moved *)
  ?preferred_dividends_row : string option;
}

(* The insurer model: the residual-income core run on AOCI-adjusted book (reported
   stockholders' equity less accumulated other comprehensive income, per period), from
   filed statements, plus the underwriting checks the lens says to read it with. The
   checks are recorded, never gates; solvency is declared null, never fabricated. *)
type insurer_inputs = {
  core : residual_income_inputs;      (* core.book_equity is the AOCI-adjusted book *)
  provider : string;
  filed : string nullable;
  accession : string nullable;
  reported_book_equity : float;
  aoci : float;
  aoci_row : string nullable;
  aoci_to_reported_book : float;      (* how much of reported book was adjusted away *)
  premiums_earned : float;
  premiums_earned_row : string nullable;
  claims_incurred : float nullable;
  claims_incurred_row : string nullable;
  benefits_losses_and_expenses : float nullable;
  benefits_losses_and_expenses_row : string nullable;
  policy_acquisition_expense : float nullable;
  policy_acquisition_expense_row : string nullable;
  operating_expense : float nullable;
  operating_expense_row : string nullable;
  combined_ratio_proxy : float nullable;
  combined_ratio_basis : string;
  future_policy_benefits : float nullable;
  future_policy_benefits_row : string nullable;
  claims_liability : float nullable;
  claims_liability_row : string nullable;
  reserves_to_premiums : float nullable;
  solvency : float nullable;          (* always null: RBC and Solvency II live in regulatory filings, not financial statements *)
  solvency_basis : string;
}

(* What the price needs to be true (12): two readouts solved by bisection on the record's
   own inputs with everything else held at its recorded value. [level] is the starting
   growth (dcf: implied_g0) or starting ROE (residual income: implied_roe0) at which fair
   value equals price; [half_life_years] is the reversion half-life (ln 2 / lambda) at
   which it does, holding the observed g0 or ROE0, attempted only when that start lies
   above its reversion target (fair value is monotone in lambda only there). A null carries
   its reason. [meaningful_readout] is decided by rule, never by hand: half_life above the
   target, level at or below it. The headline fair value does not depend on this block. *)
type readout = {
  value : float nullable;
  reason : string nullable;                   (* non-null iff value is null *)
}

type held_input = {
  name : string;
  value : float;
}

type implied = {
  level_name : string;                        (* implied_g0 | implied_roe0 *)
  level : readout;
  level_domain : float list;                  (* [low; high] *)
  ?implied_roe_target : readout option;       (* (58) residual income only: the long-run return on equity the ROE path reverts to at which fair value equals price, everything else held; the belief's parameter on that path *)
  ?roe_target_domain : float list option;     (* (58) [cost of equity - 0.10; cost of equity + 0.30] *)
  half_life_years : readout;
  lambda_domain : float list;                 (* [low; high]; half-lives from ln 2 / high to ln 2 / low *)
  ?horizon_years : readout option;            (* (14) the smallest whole number of explicit years, holding the observed start, at which fair value reaches the price; integer scan over 1..40, only under the guard; absent on records from before it *)
  ~horizon_bracket : float list;              (* (14) fair value at N-1 and at N when solved; empty otherwise *)
  ?fair_value_at_40 : float option;           (* (14) fair value at a 40-year explicit period, under the guard; absent otherwise *)
  ~rf_tenor : string;                         (* (14) how the risk-free rate is treated across horizons *)
  meaningful_readout : string;                (* level | half_life | horizon (14) *)
  meaningful_rule : string;                   (* the comparison that decided it, with the numbers *)
  solver : string;                            (* bisection *)
  tolerance : float;                          (* on the solved variable *)
  held : held_input list;                     (* every input held at its recorded value *)
}

(* The REIT model (18): a dividend discount on the dividend FFO covers. FFO per NAREIT from
   filed tags (net income + real-estate depreciation and amortisation + impairments - gains
   on property sales); D0 = min(dividends, FFO) / effective shares, so an uncovered dividend
   is never valued; g0 = the CAGR of FFO per cover-page share over the filed periods,
   clamped and mean-reverting toward terminal growth as the DCF's growth does (the growth
   series divides each period's FFO by that period's weighted-average diluted count, per
   shares_for_flows; the level per share is on effective shares, per shares_for_market_cap);
   the cost of equity is CAPM with the REIT industry beta. Value = sum of D_t / (1 + ke)^t plus a Gordon
   terminal on D_N. AFFO is not derivable from tags: FFO overstates distributable cash by
   the recurring capex and non-cash rent the filer does not tag, which [caveat] says. *)
type reit_inputs = {
  fiscal_period_end : string;
  country : string;
  industry : string nullable;
  price : float;
  market_cap : float;
  shares : float;                     (* effective shares = market_cap / price *)
  ffo : float;
  ffo_composition : composition nullable;
  ffo_per_share : float;              (* ffo / shares *)
  price_to_ffo : float;
  dividends_paid : float;
  dividends_paid_row : string nullable;
  coverage : float;                   (* dividends_paid / ffo *)
  covered_dividend : float;           (* min (dividends_paid, ffo) *)
  dividend_per_share : float;         (* D0 = covered_dividend / shares *)
  ffo_per_weighted_share : (string * float) list <json repr="object">;   (* period end -> ffo / the period's weighted-average diluted shares, the growth series (19) *)
  weighted_shares_tags : (string * string) list <json repr="object">;     (* period end -> the count's tag *)
  ffo_periods : string list;          (* the periods the CAGR spans *)
  g_historical : float;               (* the FFO-per-share CAGR *)
  g0 : float;                         (* after the clamp *)
  growth_clamped : bool;
  growth_clamp_lower : parameter;
  growth_clamp_upper : parameter;
  mean_reversion_lambda : parameter;
  growth_path : float list;
  risk_free_rate : parameter;
  equity_risk_premium : parameter;
  ?country_risk_premium : parameter option;
  beta : parameter;
  beta_source : beta_source;
  cost_of_equity : float;
  ?conversion : conversion option;
  terminal_growth_rate : parameter;
  projection_years : int_parameter;
  dividend_path : float list;         (* D_1 .. D_N per share *)
  pv_dividends : float;
  terminal_value : float;             (* D_N (1 + g_T) / (ke - g_T), at N *)
  pv_terminal_value : float;
  equity_value : float;               (* per share: pv_dividends + pv_terminal_value *)
  caveat : string;
}

(* The inputs of whichever model ran, tagged with it. *)
(* One through-cycle return observation (22, 25): the period's NOPAT, bottom-up from filed
   lines (net income + interest expense x (1 - statutory tax rate); no operating-income line
   is needed, and the through-cycle mean is what dampens one-offs), over the invested capital
   (book equity + total debt - cash) at the end of the previous period. *)
type roic_observation = {
  period_end : string;
  prior_period_end : string;
  ?net_income : float option;         (* as filed; an input on the bottom-up recipe, a readout beside the operating-income one *)
  ?interest_expense : float option;
  ~interest_recipe : string;          (* filed | net_nonoperating_interest | interest_paid_stands_in (31) *)
  ?ebit : float option;               (* the filed operating income, on the operating-income recipe *)
  ?tax_rate : float option;           (* on that recipe: the period's effective rate where derivable by the DCF's rule, else the statutory rate *)
  ?nopat_bottom_up : float option;    (* net_income + interest_expense * (1 - statutory tax rate), where both are filed; the nopat on the bottom-up recipe, a readout on the other *)
  nopat : float;                      (* operating_income_after_tax: ebit * (1 - tax_rate); nopat_bottom_up: the line above *)
  invested_capital_prior : float;     (* book_equity + total_debt - cash at prior_period_end *)
  roic : float;                       (* nopat / invested_capital_prior *)
}

(* A period the mid-cycle window could not use in one of its sums (27): dropped from that
   sum, named, and the guards count what remains. *)
type midcycle_exclusion = {
  period_end : string;
  sum : string;                       (* roic | reinvestment *)
  missing : string;                   (* the field the period lacks for that sum *)
}

(* The mid-cycle DCF (22): the DCF engine run on through-cycle earning power instead of
   the latest year's flow. [dcf] is the engine's own record on the mid-cycle flow: fcff =
   fcff_mid, g0 = roic_mid * reinvestment_rate_mid before the clamp, nopat = nopat_mid,
   roic and reinvestment_rate the mid-cycle ones, the tax rate statutory; ebit on it is the
   pre-tax equivalent of the latest period's bottom-up nopat (nopat / (1 - tax rate), recipe
   nopat_bottom_up), d&a, capex and delta_nwc the latest period's own (spot) values, recorded
   for spot_fcff, each null when the latest period lacks it (27), and its delta_nwc_periods
   is that one period when present. The latest period must carry the balance sheet only
   (required_on_latest_period in field_definitions.json). Everything else on [dcf] (parameters,
   wacc, path, terminal, net debt, shares) is exactly the DCF's. *)
type midcycle_inputs = {
  dcf : inputs;
  nopat_recipe : string;              (* operating_income_after_tax when every period in the window carries a filed operating-income line; else nopat_bottom_up (25): net income + interest expense x (1 - statutory tax rate), per period. One recipe per name, never mixed inside a window *)
  ?roic_mid_bottom_up : float option; (* on the operating-income recipe, the bottom-up mean on the same observations, for the reader: far from roic_mid means non-operating items are the difference *)
  midcycle_window_years : int_parameter;
  window : string list;               (* the fiscal period ends in the window, newest first: every annual period the record carries, up to midcycle_window_years *)
  observations : roic_observation list;   (* one per consecutive pair in the window with net income, interest expense and a positive prior invested capital; at least 8 *)
  ~exclusions : midcycle_exclusion list;  (* (27) every period dropped from a sum, with the field it lacked *)
  roic_mid : float;                   (* arithmetic mean of the observations' roic, the bad years included *)
  roic_median : float;                (* a readout beside it, not used *)
  invested_capital_latest : float;    (* the newest period's book_equity + total_debt - cash *)
  nopat_mid : float;                  (* roic_mid * invested_capital_latest *)
  reinvestment_periods : string list; (* the window periods with capex, d&a, delta_nwc, net income and interest expense, summed; at least 8 (27) *)
  reinvestment_sum : float;           (* sum over reinvestment_periods of capex - d&a + delta_nwc *)
  nopat_sum : float;                  (* sum over reinvestment_periods of nopat_t *)
  reinvestment_rate_mid : float;      (* reinvestment_sum / nopat_sum, sums never a mean of ratios, floored at zero (33) *)
  ?reinvestment_rate_measured : float option;   (* (33) the ratio of sums as measured, present only when the floor bound (it was negative) *)
  ~reinvestment_floor_applied : bool; (* (33) true when the measured rate was negative: no net reinvestment through the cycle, fcff_mid = nopat_mid, g0 = 0; disinvestment cash flows are not valued *)
  ?reinvestment_floor_note : string option;
  fcff_mid : float;                   (* nopat_mid * (1 - reinvestment_rate_mid) *)
  spot_fcff : float nullable;         (* the latest period's own fcff at the same tax rate; a readout, null with spot_reason when the latest period lacks a flow (27) *)
  spot_to_midcycle : float nullable;  (* spot_fcff / fcff_mid: how far off-cycle the current year is *)
  ?spot_reason : string option;
}

type model_inputs = [
  | Dcf <json name="dcf"> of inputs
  | Dcf_midcycle <json name="dcf_midcycle"> of midcycle_inputs
  | Residual_income <json name="residual_income"> of residual_income_inputs
  | Residual_income_insurer <json name="residual_income_insurer"> of insurer_inputs
  | Reit_ffo_dividend <json name="reit_ffo_dividend"> of reit_inputs
  | Bdc_nav <json name="bdc_nav"> of bdc_inputs
]

(* Sensitivity (23): the anchor re-evaluated at each held input stepped down and up by a
   declared readability step, everything else at its recorded value. Deterministic; no
   distribution, no sampling; the steps are not standard deviations. *)
type sensitivity_entry = {
  input : string;                     (* the held input's name *)
  recorded : float;
  step : float;                       (* the declared step: absolute for a rate, a fraction of the recorded value for the base *)
  step_kind : string;                 (* absolute | relative *)
  down : readout;                     (* fair value at recorded - step; null with reason when the step crosses a guard *)
  up : readout;                       (* fair value at recorded + step *)
  swing : float nullable;             (* |up - down| / fair_value; null iff a side is null *)
}

type sensitivity = {
  fair_value : float;                 (* the anchor the swings are measured against *)
  steps_source : string;              (* provenance of the steps, from reference/params.json *)
  steps_as_of : string;
  entries : sensitivity_entry list;   (* in the held order *)
  ranking : string list;              (* inputs with a swing, largest first *)
  binding_input : string nullable;    (* the first of ranking; null when no entry has a swing *)
  note : string;                      (* what the block says and does not say *)
}

(* The belief map (23): the plain-language readout model, distinct from the headline's
   decaying path and stated as such: growth held at g for N years with no decay, then the
   settled terminal growth forever, everything else at its recorded value. *)
type contour_point = {
  years : int;
  growth : readout;                   (* the g at which fair value equals price; null with reason when no g in the domain reaches it *)
}

type belief_map = {
  map_model : string;                 (* "undecayed growth for N years, then terminal" *)
  base_name : string;                 (* fcff | fcff_mid | dividend_per_share *)
  base : float;                       (* the cash-flow base the growth compounds from *)
  rate_name : string;                 (* wacc | cost_of_equity *)
  rate : float;
  terminal_growth_rate : float;
  net_debt : float;                   (* 0 on a per-share base *)
  shares : float;                     (* 1 on a per-share base *)
  observed_growth : float;            (* the record's g0 *)
  growth_domain : float list;         (* [0; 0.5] *)
  growth_step : float;                (* 0.02: the grid's step *)
  horizon_max : int;                  (* 40 *)
  price_contour : contour_point list; (* one per N = 1..40 *)
  solver : string;
  tolerance : float;
}

(* The whole grid, written to output/maps/(ticker).json (23), never onto the record. *)
type belief_grid = {
  ticker : string;
  map_model : string;
  price : float;
  observed_growth : float;
  growth_grid : float list;           (* 0, 0.02 .. 0.5 *)
  horizon_grid : int list;            (* 1 .. 40 *)
  fair_values : float list list;      (* one row per growth, one column per horizon *)
  price_contour : contour_point list;
}

(* The declared belief (24) as resolved for the record: the six fields, in decimal
   fractions of long-run nominal growth. Carried beside the probability so the number
   never travels without its basis. *)
type belief = {
  mean : float;
  sd : float;
  floor : float;
  ceiling : float;
  why : string;
  as_of : string;
}

type belief_readout = {
  declared : belief;
  source : string;                    (* class default (offsets around the country's terminal growth) or a per-name entry *)
  belief_version : string;            (* the belief's as_of, a short hash of its six fields, and class or name *)
  ~belief_parameter <ocaml default="\"long_run_growth\""> : string;  (* (58) what the belief and the curve are about; long_run_growth is the default and is omitted from the record, long_run_return_on_equity is written on the residual-income path *)
  ?implied_terminal_growth : readout option;  (* the fourth readout on the DCF-shaped paths: the long-run growth at which fair value equals price on the headline's decaying path, everything else held; null with reason past either end of implied_domain *)
  ?implied_roe_target : readout option;       (* (58) the same readout on the residual-income path, in the long-run return on equity *)
  implied_domain : float list;        (* [-0.10; discount rate - 0.0005], or [ke - 0.10; ke + 0.30] on the residual-income path *)
  probability_overpaid : float;       (* P(the belief's parameter < implied) under the belief: the probability that the value surplus is negative; 1 or 0 with probability_reason when the implied readout is null *)
  ?probability_reason : string option;
  value_surplus : float;              (* the margin of safety: (fair value - price) / price, the book's value surplus *)
  note : string;
}

(* One point of the value-surplus curve (35): the margin of safety (V - P) / P the model
   gives at one value of the belief's parameter, everything else at its recorded value.
   [growth] is that parameter's value: long-run growth on the DCF-shaped paths, and (58) the
   long-run return on equity on the residual-income path, which belief_parameter names. *)
type surplus_point = {
  growth : float;
  surplus : float;
}

(* The BDC lens (59). A business development company is a portfolio of loans and equity
   stakes marked to fair value every quarter; its earnings measure is net investment income
   and its payout is a regulated distribution. It is NOT a discount model: fair value is the
   filed net asset value per share and nothing else, because the filing's own mark is the
   anchor and the tool does not second-guess a portfolio of private loans it cannot see. No
   discount rate, no growth rate and no projection appear anywhere on this path, so the
   record carries none of the country parameters: they gate the pipeline, they are not
   inputs to the lens. The readouts are what make the mark useful to a reader: the premium
   or discount the market puts on it, what the portfolio earns against it, what the holder
   is paid, and whether that payment is covered. *)
type bdc_inputs = {
  fiscal_period_end : string;
  country : string;
  industry : string nullable;
  price : float;
  market_cap : float;
  shares : float;                        (* effective shares = market_cap / price, as everywhere *)
  net_asset_value_per_share : float;     (* the anchor, and the fair value *)
  net_asset_value_row : string;
  ?net_asset_value_composition : composition option;   (* present when the per-share figure was not filed and net assets over shares was used *)
  net_investment_income : float;
  net_investment_income_row : string;
  ?net_investment_income_composition : composition option;
  weighted_shares : float;               (* the period's own weighted-average count, per shares_for_flows: a flow per share may use no other *)
  weighted_shares_tag : string;
  net_investment_income_per_share : float;
  distributions_per_share : float;
  distributions_per_share_row : string;
  price_to_nav : float;                  (* price / net asset value per share: above 1 is a premium *)
  nii_yield_on_nav : float;              (* net investment income per share / net asset value per share *)
  distribution_yield : float;            (* distributions per share / price *)
  nii_coverage : float;                  (* net investment income per share / distributions per share *)
  coverage_note : string;                (* what the coverage means, and that below 1 the distribution erodes the net asset value *)
  nav_per_share_series : (string * float) list <json repr="object">;   (* period end -> the filed net asset value per share *)
  nav_periods : string list;             (* the periods the CAGR spans, newest first *)
  nav_cagr : float;                      (* the compound growth of the filed mark over those periods, measured in calendar years *)
  ?conversion : conversion option;
  caveat : string;                       (* the mark is the filer's own, on assets with no quoted price; the tool records it, it does not verify it *)
}

(* The options store (36): one file per name and snapshot date, data/options/(date)/(TICKER).json,
   written by python/fetch_options.py from ThetaData's end-of-day chain through the local
   ThetaTerminal, the full chain unfiltered. Prices are in the option's quote currency (USD on
   ThetaData's US listings); sizes and counts are contracts. Never tracked. *)
type option_quote = {
  expiration : string;                (* YYYY-MM-DD *)
  strike : float;
  right : string;                     (* call | put *)
  bid : float;
  ask : float;
  mid : float;                        (* (bid + ask) / 2 *)
  bid_size : int;
  ask_size : int;
  last : float;                       (* the option's close on the snapshot date; 0 when it did not trade *)
  volume : int;
  count : int;                        (* trades on the snapshot date *)
}

type option_chain = {
  ticker : string;
  snapshot_date : string;             (* YYYY-MM-DD, the date the end-of-day rows describe *)
  snapshot_timestamp : string;        (* the vendor's created stamp on the rows *)
  source : string;                    (* the endpoint the quotes came from *)
  underlying_close : float;           (* the underlying's close on the snapshot date, from the stock endpoint *)
  underlying_source : string;
  fetched_at : string;                (* when the file was written *)
  quotes : option_quote list;
}

(* Every expiry's smile on one chain (38): what python/hedge.py reads from the smile
   executable for Greeks at quoted strikes, the stale-quote flag and the floor probability;
   the fit is brief 36's, expiry by expiry, and never prices a leg. *)
type expiry_smile = {
  expiry : string;
  days_to_expiry : int;
  forward : float;
  forward_source : string;
  ?smile : svi_smile option;          (* absent with the reason when the expiry has too few quotes or the fit fails the arbitrage check *)
  ?reason : string option;
}

type chain_smiles = {
  ticker : string;
  snapshot_date : string;
  spot : float;
  risk_free_rate : float;
  expiries : expiry_smile list;
}

(* Stretch (52): how far a price has run from its own path, six measures from
   split-corrected closes and volume with each measure's percentile of the name's own
   trailing two years, and two counts against declared thresholds. Computed at fetch time
   (python/stretch.py), copied through by the batch, never a Failed. *)
type stretch_measure = {
  value : float;
  percentile : float;                 (* of the name's own trailing two years of the same measure, 0 to 100 *)
}

type stretch = {
  as_of : string;                     (* the close used *)
  dd_120 : stretch_measure;           (* close over the 120-day high, minus one *)
  above_120_low : stretch_measure;    (* close over the 120-day low, minus one *)
  vs_ma50 : stretch_measure;
  vs_ma200 : stretch_measure;
  rsi_14 : stretch_measure;           (* Wilder's *)
  rv_20 : stretch_measure;            (* 20-day realised volatility, annualised *)
  rv_ratio : stretch_measure;         (* rv_20 over the name's one-year median of rv_20 *)
  vol_5_60 : stretch_measure;         (* five-day average volume over the prior sixty *)
  stretch_low : int;                  (* of dd_120, vs_ma50, vs_ma200, rsi_14 at or beyond the low threshold: 0 to 4 *)
  stretch_high : int;                 (* of above_120_low, vs_ma50, vs_ma200, rsi_14 at or beyond the high threshold *)
  thresholds_version : string;        (* reference/stretch.json's as_of *)
  history_days : int;                 (* closes on or before as_of that fed it *)
}

(* Form 4 (66): what the people with the most information did about the price, filed,
   timestamped and keyless. Open-market purchases and sales only: an award, an exercise, a
   withholding or a gift is counted by its code and never summed, because an
   exercise-and-sell is not a sale of conviction. No score and no weight lives here; the
   block counts and lists, and the reader decides what it means. Every figure is computed
   from filings made on or before the valuation date, so the point-in-time panel carries it
   unchanged. *)
type insider_transaction = {
  owner : string;                     (* the reporting owner, as filed *)
  relationship : string;              (* director | officer: <title> | ten-percent owner | other, as filed, joined by "; " where more than one *)
  transaction_date : string;
  code : string;                      (* P (open-market or private purchase) or S (open-market sale); nothing else reaches here *)
  shares : float;
  price_per_share : float;
  dollars : float;                    (* shares x price_per_share *)
  ?shares_owned_after : float option;
  accession : string;
  filed : string;
  ~plan_10b5_1 : bool;                (* the filing's plan marking, where it carries one: scheduled, not decided *)
}

(* One seller inside a window: what they sold and how much of what they reported holding. *)
type insider_seller = {
  owner : string;
  relationship : string;
  sales : int;                        (* open-market sale lines in the window *)
  shares_sold : float;
  dollars_sold : float;
  plan_dollars_sold : float;          (* of dollars_sold, the part on filings that mark a Rule 10b5-1 plan *)
  ?shares_owned_after : float option; (* summed over the ownership lines sold from (direct, each trust), each as its last sale in the window reported it; absent when a line gives none *)
  ?fraction_of_holdings_sold : float option;  (* shares_sold / (shares_sold + shares_owned_after); absent with shares_owned_after *)
}

type insider_window = {
  days : int;                         (* 90 or 365, ending at as_of *)
  buyers : int;                       (* distinct owners with at least one purchase *)
  sellers : int;
  dollars_bought : float;
  dollars_sold : float;
  net_dollars : float;                (* bought less sold *)
  ?largest_purchase : insider_transaction option;
  ceo_or_cfo_bought : bool;           (* any buyer whose filed officer title names a chief executive or chief financial officer *)
  ~plan_sales : int;                  (* sale lines on filings that mark a Rule 10b5-1 plan: scheduled, not decided *)
  ~plan_sellers : int;                (* distinct sellers with at least one such sale *)
  ~plan_dollars_sold : float;         (* of dollars_sold, the part on such filings *)
  ~sellers_detail : insider_seller list;   (* every seller in the window, largest dollars first *)
}

(* Two distinct insiders buying on the open market inside one fourteen-day window, which is
   the standard definition and is kept for that reason; one insider buying twice is not one. *)
type insider_cluster = {
  window_start : string;
  window_end : string;
  buyers : string list;               (* at least two, distinct *)
}

type insiders = {
  as_of : string;                     (* the valuation date the windows end at *)
  cik : string;
  window_90 : insider_window;
  window_365 : insider_window;
  ~cluster_buy : bool;
  ?cluster : insider_cluster option;  (* present iff cluster_buy *)
  filings_read : int;                 (* Form 4 and 4/A documents parsed within the year *)
  ~excluded_by_code : (string * int) list <json repr="object">;   (* codes seen and not summed, counted by code *)
  ~scope_limits : string list;        (* what Form 4 cannot see for this name *)
}

(* The depositary-receipt check (42): on a name with a declared ratio or a financial
   currency different from its trading currency, the cover page's ordinary count over the
   live effective shares (market cap / price, receipt units) against the declared ratio;
   a flag, never a gate or a correction; present iff the financials carry the cover page. *)
(* (68) The earnings gate. Every options readout picks an expiry without knowing whether a
   results release sits inside it, and a spread or a hedge across one is a different
   instrument. The block never fails a record, adds no `Failed` string, and nothing in the
   valuation reads it.

   The calendar is filed and keyless: every 8-K carrying item 2.02, Results of Operations
   and Financial Condition, over the last five years, from SEC's own submissions index. A
   filer with no 2.02 at all -- a foreign private issuer files 6-K, a trust files neither --
   falls back to the vendor's dates, and the record says which it read. *)
type earnings_event = {
  filed : string;                 (* the 8-K's filing date, or the vendor's date *)
  before : string;                (* the last close on or before it *)
  after : string;                 (* the first close after it *)
  own : float;                    (* close to close across the release, a simple return *)
  benchmark : float;              (* the same two dates on the benchmark *)
  excess : float;                 (* own less benchmark *)
}

type earnings_calendar = {
  past_source : string;           (* SEC 8-K item 2.02 | vendor *)
  past_source_why : string;       (* why that source and not the other *)
  past_count : int;               (* releases found in the five years to the date *)
  past_dates : string list;       (* every one of them, oldest first *)
  next_date : string;
  next_source : string;           (* vendor | filed cadence, projected *)
  next_source_as_of : string;     (* the vendor fetch date, or the last filed release the projection ran from *)
  ?cadence_days : float option;   (* the median interval of the last eight releases; the projection's step, and the reader's check that the cadence is quarterly *)
  events : earnings_event list;   (* the last eight, oldest first; fewer where the history or the closes are shorter *)
  ?realised_median_abs_excess : float option;   (* the median absolute excess move over those events *)
  ?realised_reason : string option;             (* present instead: why there is no median *)
  benchmark : string;
  scope_limits : string list;
}

type earnings_implied = {
  snapshot_date : string;         (* the options snapshot the two expiries were read on *)
  earlier_expiry : string;
  later_expiry : string;
  earlier_total_variance : float; (* the fitted smile at the forward: implied volatility squared times years *)
  later_total_variance : float;
  event_variance : float;         (* the later less the earlier *)
  implied_move : float;           (* its square root *)
  forward_convention : string;    (* one convention for both legs, or the difference of two small numbers is noise *)
}

type earnings = {
  calendar : earnings_calendar;
  days_to_next : int;             (* from valued_on; negative when the calendar has aged past the release *)
  ?implied : earnings_implied option;
  ?implied_reason : string option;            (* present instead: why there is no implied move *)
  ?implied_over_realised : float option;      (* the implied move over the realised median; present iff both are *)
}

type receipt_check = {
  cover_page_shares : float;
  cover_page_shares_as_of : string;
  effective_shares : float;
  implied_ratio : float;              (* cover_page_shares / effective_shares *)
  declared_ratio : float nullable;    (* the universe entry's adr_ratio; null when none is declared *)
  ?cover_page_split_factor : float option;   (* (44) applied to cover_page_shares before the comparison when the record carries it *)
  ?flag : string option;              (* depositary ratio mismatch: ... | undeclared depositary ratio: live shares imply ... *)
}

(* The market-implied readout (36): the risk-neutral distribution of the price at one
   expiry, read from the chain beside the declared belief. Every field is risk-neutral: it
   embeds the market's risk pricing and is not a forecast. *)
type svi_smile = {
  a : float;                          (* total implied variance w(k) = a + b (rho (k - m) + sqrt((k - m)^2 + sigma^2)), k = ln(K / F) *)
  b : float;
  rho : float;
  m : float;
  sigma : float;
  rmse : float;                       (* root mean square error in total variance over the quotes fitted *)
  quotes_fitted : int;                (* out-of-the-money quotes with a positive bid and ask <= 3 bid whose mid inverted to an implied volatility *)
  quotes_excluded_wide : int;         (* out-of-the-money quotes left out of the fit because ask > 3 bid: a spread wider than the mid says nothing about the price *)
  spread_rule : string;               (* ask <= 3 bid *)
  put_call_iv_gap_at_forward : float nullable;   (* implied vol of the nearest put below the forward minus the nearest call at or above it; single-stock US options are American and the inversion is European, so a long-dated put's early-exercise premium shows here as a positive gap; a diagnostic, never corrected *)
}

type price_quantile = {
  p : float;                          (* 0.05, 0.25, 0.50, 0.75, 0.95 *)
  price : float;                      (* the price at expiry at that risk-neutral quantile *)
}

type growth_quantile = {
  p : float;
  growth : readout;                   (* the long-run growth at which fair value equals the quantile price discounted at ke; null with reason past either end *)
}

type market_implied = {
  source : string;
  snapshot_date : string;
  snapshot_timestamp : string;
  spot : float;                       (* the underlying's close on the snapshot date; the record's price may be another day's *)
  forward : float;                    (* put-call parity at the straddle strike nearest spot, else spot compounded at rf *)
  forward_source : string;
  risk_free_rate : float;             (* the record's risk-free rate, discounting the option horizon *)
  expiry : string;                    (* the longest expiry at least 365 days out with at least eight OTM strikes quoted on each side of spot *)
  horizon_years : float;              (* calendar days to expiry / 365 *)
  otm_quoted_below : int;             (* put strikes below spot with a positive bid *)
  otm_quoted_above : int;             (* call strikes above spot with a positive bid *)
  smile : svi_smile;                  (* checked for butterfly arbitrage (g(k) >= 0) and Lee's wing bound *)
  price_quantiles : price_quantile list;   (* Breeden-Litzenberger on the fitted smile, in closed form *)
  anchor_path_price : float;          (* fair value grown at the required return used: V (1 + ke)^T *)
  p_below_anchor_path : float;        (* the risk-neutral probability that the price at expiry is below the anchor path *)
  implied_growth_quantiles : growth_quantile list nullable;   (* each price quantile discounted at ke to today, inverted through the implied-terminal-growth solver; null on the residual-income paths *)
  ?implied_growth_reason : string option;
  implied_growth_label : string;      (* approximate *)
  implied_growth_note : string;       (* why: a horizon of a few years standing in for the long run *)
  risk_neutral : bool;                (* always true *)
  note : string;
  ?spans_earnings : bool option;      (* (68) true when this expiry lies after the next earnings date; the readout is unchanged either way, the expiry is not reselected, and nothing is excluded *)
  ?earnings_implied_move : float option;   (* (68) the event's implied move, beside the flag *)
  ?spans_earnings_reason : string option;  (* (68) present instead: why the flag cannot be set *)
}

(* (60) The build-out readout: what the new capital must earn for the price to be right.
   A map, never a value. It appears on a record that is already Failed, carries no fair
   value, no margin of safety and no signal, and nothing downstream reads it. Growth capex
   in a year is capex less depreciation where positive; depreciation is the proxy for
   maintenance because no filer discloses the split. *)
type build_out_declaration = {
  value : float;
  why : string;
  as_of : string;
}

type build_out_tranche = {
  period_end : string;
  years_before_latest : int;            (* 0 for the latest filed year *)
  capex : float;
  depreciation_amortization : float;
  growth_capex : float;                 (* capex - depreciation where positive, else zero *)
}

type build_out_row = {
  lag_years : int;
  value_per_share : float list;         (* one per return on the returns axis, in that order *)
}

type build_out_contour = {
  lag_years : int;
  return_required : float nullable;     (* (63) the ACCOUNTING return at which value equals price at this lag *)
  ?contour_reason : string option;      (* present iff return_required is null: no return in the declared range reaches the price *)
}

type build_out = {
  declared_return : build_out_declaration;       (* (63) the after-tax ACCOUNTING return on new capital, after depreciation: the units a filing and a reader use *)
  declared_lag_years : build_out_declaration;
  cash_return : float;                           (* (63) the declaration converted: the accounting return plus depreciation_to_capital, the cash yield the tranche earns before the maintenance this readout charges it *)
  conversion_note : string;                      (* (63) how the two relate, on the record *)
  maintenance_note : string;
  tranches : build_out_tranche list;    (* the last three filed years, newest first *)
  standing_business_per_share : float;  (* the standing business alone, after net debt, per effective share *)
  net_debt : float;
  shares : float;
  wacc : float;
  tax_rate : float;
  terminal_growth_rate : float;
  depreciation_to_capital : float;      (* the latest depreciation over the latest invested capital: each tranche's own maintenance *)
  returns : float list;                 (* (63) the return axis in ACCOUNTING terms, as the declaration is: declared - 0.15 to declared + 0.15 in 1 pp steps *)
  surface : build_out_row list;         (* one row per lag 0 .. 6 *)
  price_contour : build_out_contour list;
  scope_limits : string list;           (* what this map cannot see, carried onto the record *)
}


(* (76) The runway readout. The Unprofitable class is refused by design, its lens being
   cash runway against the catalyst calendar, and until now the record carried the lens's
   name and nothing of the lens. This is the reading: the latest period's cash and
   short-term investments as the definitions read them, the free cash flow of that period
   from the cash-flow statement's own lines (net cash from operating activities less
   capital spending), the burn where that is negative, the years of runway as
   cash over burn, and the release dates the earnings calendar puts inside those years. A
   state, not a forecast: nothing here is a fair value, a floor or a signal, and nothing
   downstream reads it. *)
type runway_period = {
  period_end : string;
  free_cash_flow : float;
}

(* The options-implied expected return (Martin and Wagner, JF 2019): a required return read
   from option prices alone, beside CAPM and the declared one. Every variance is risk-neutral
   and annualised. Present only under --options, on a record of a name that is not a fund. *)
type options_expected_return = {
  snapshot_date : string;             (* the chain's, the same as the benchmark's *)
  expiry : string;                    (* the name's longest expiry at least 365 days out with eight quoted strikes each side *)
  horizon_years : float;
  risk_free_rate : float;             (* of the benchmark's currency, at the record's tenor *)
  svix2 : float;                      (* the name's risk-neutral return variance: 2 / F^2 times the integral of out-of-the-money option prices over strike, on the fitted smile, per year *)
  strike_range : float list;          (* the lowest and the highest strike the integral ran between, as multiples of the forward *)
  benchmark : string;
  benchmark_expiry : string;
  market_svix2 : float;               (* the benchmark fund's *)
  average_svix2 : float;              (* the market-capitalisation-weighted mean of svix2 over the names in the run with a usable chain *)
  names_in_average : int;
  in_average : bool;                  (* false when this name has no market capitalisation on the record and was left out of the mean *)
  expected_excess_return : float;     (* (1 + rf) * (market_svix2 + (svix2 - average_svix2) / 2), per year *)
  expected_return : float;            (* risk_free_rate + expected_excess_return *)
  scope_limits : string list;
}

(* The base rate beside the growth the record uses and the growth the price needs: how often
   companies of this size grew their revenue that fast over five years. The outside view,
   a frequency from filed history; never a belief, never an input to a fair value. On a
   record valued by a DCF-shaped model whose statements and price are in dollars. *)
type base_rate = {
  horizon_years : int;                (* 5 *)
  starting_revenue : float;           (* the latest fiscal year's, dollars *)
  bucket : string;                    (* the starting-size class it falls in *)
  n : int;                            (* companies with revenue at both ends of a window in that class *)
  not_reported_at_end : int;          (* started in the class and filed no revenue at the end: left out, so the frequencies describe survivors *)
  years : string;                     (* the calendar years the table covers *)
  median_growth : float;              (* the class's median compound annual revenue growth over the horizon *)
  headline_growth : float;            (* the compound annual growth over the horizon on the record's own growth path *)
  headline_share : float;             (* the share of the class that grew at least that fast; held to [0.01, 0.99], the table's resolution *)
  ?implied_growth : float option;     (* the same on the path the price needs (implied_g0 decaying as the model's does); absent with the reason *)
  ?implied_share : float option;
  ?implied_reason : string option;
  scope_limits : string list;
}

(* One fiscal year's research and development expense as filed. *)
type rd_year = {
  period_end : string;
  value : float;
  tag : string;      (* the element it was filed under *)
  filed : string;    (* ISO date of the filing the value was read from *)
}

(* The R&D shadow: what the generic DCF would read if research and development were an
   investment and not a cost. A shadow beside the headline, never the headline: fair_value,
   margin_of_safety and signal on the record are untouched by it. The expense of the latest
   year and of the [amortization_years] years before it is capitalised straight-line: the
   research asset joins invested capital, the year's amortisation replaces the year's expense
   in operating profit, and the net investment joins reinvestment. Free cash flow is unchanged
   by construction (the expense was cash either way), so the shadow differs from the headline
   only through the return on capital and the reinvestment rate, that is through the starting
   growth. *)
type rd_shadow = {
  amortization_years : int;           (* the declared straight-line life, params.json rd_amortization_years *)
  amortization_years_source : string;
  rd_latest : float;                  (* the latest fiscal year's expense *)
  rd_years : string list;             (* the fiscal year ends read: the latest and the amortization_years before it *)
  rd_tag : string;                    (* the element of the latest year's expense *)
  research_asset : float;             (* the unamortised balance: sum over k = 0..N-1 of expense(t-k) * (N-k)/N *)
  amortization : float;               (* this year's: sum over k = 1..N of expense(t-k) / N *)
  nopat : float;                      (* the headline's *)
  nopat_adjusted : float;             (* nopat + rd_latest - amortization: the expense stays fully deductible, so the add-back is untaxed *)
  invested_capital : float;           (* the headline's *)
  invested_capital_adjusted : float;  (* invested_capital + research_asset *)
  roic : float nullable;              (* the headline's *)
  roic_adjusted : float nullable;
  reinvestment_rate : float nullable; (* the headline's *)
  reinvestment_rate_adjusted : float nullable;
  growth_source : growth_source;      (* the headline's *)
  growth_source_adjusted : growth_source;
  g0 : float;                         (* the headline's starting growth *)
  g0_adjusted : float;
  fcff : float;                       (* identical on both sides, recorded as the check *)
  headline_fair_value : float;        (* the DCF's own value on the unadjusted statements, before any gate *)
  fair_value : float;                 (* what the headline would be with research and development capitalised *)
  margin_of_safety : float;           (* (fair_value - price) / price, the shadow's *)
  scope_limits : string list;
}

type runway = {
  period_end : string;                    (* the latest fiscal period *)
  cash : float;                           (* cash and short-term investments, the cash definition *)
  ?total_debt : float option;             (* beside it, for the reader; not netted *)
  free_cash_flow : float;                 (* operating cash flow less capex, the latest period, the cash-flow statement's own *)
  burn : float nullable;                  (* -free_cash_flow where negative; null when the period funded itself *)
  years_of_runway : float nullable;       (* cash / burn; null when there is no burn *)
  self_funding : bool;
  history : runway_period list;           (* every filed period carrying the four flows, newest first *)
  ?next_release : string option;          (* the earnings calendar's next date *)
  ?days_to_next : int option;             (* from valued_on *)
  ?cadence_days : float option;           (* the calendar's median interval, the step the count below runs at *)
  ?releases_within_runway : int option;   (* releases the cadence puts inside the years of runway, counting the next; null with no burn or no calendar *)
  ?calendar_reason : string option;       (* present instead of the four above: why the calendar gives nothing *)
  basis : string;                         (* what was read, in words *)
}

type valuation = {
  ticker : string;
  as_of : string;                     (* the fetch timestamp, from financials *)
  valued_on : string;                 (* ISO 8601 date parameter ages are measured at *)
  ~model_version : string;            (* the code that produced the record: git short hash, "-dirty" when the tree had uncommitted edits, "unversioned" outside a checkout (21); empty only on records written before it existed *)
  currency : string nullable;         (* basis of price and fair_value *)
  price : float nullable;
  fair_value : float nullable;        (* per share *)
  margin_of_safety : float nullable;  (* (fair_value - price) / price *)
  signal : signal nullable;
  entity_class : entity_class nullable;   (* as declared; null iff not declared *)
  model : model nullable;                 (* the model the record was routed to *)
  class_check : class_check nullable;
  floor : floor;
  scope_limits : string list;             (* what the models cannot see for this name, verbatim from the declaration *)
  ~scope_limit_codes : string list;       (* one stable code per scope limit, in the same order; absent when the record carries no limit; "uncoded" where a declaration predates the codes *)
  statements_provider : string;           (* the provider decision, on every record *)
  ~taxonomy : string;                     (* us-gaap | ifrs-full on filed statements; empty otherwise (13) *)
  market_provider : string;
  provider_reason : string;
  ?filing_age_days : int option;          (* valued_on - latest_filing, when the statements are filed ones *)
  ?cross_check : cross_check option;      (* carried verbatim from the record *)
  ?submissions_latest_annual : submission option;   (* carried verbatim from the record (14) *)
  ?point_in_time : point_in_time option;            (* from the record, anachronistic_inputs filled (17) *)
  status : status;
  failed_reason : string nullable;
  inputs : model_inputs nullable;
  ?implied : implied option;              (* present iff status is Ok (12), and (59) the model has something to solve for *)
  ?implied_reason : string option;        (* (59) why there are no implied readouts: a model whose anchor is a filed mark has no parameter to invert *)
  ?sensitivity : sensitivity option;      (* present iff status is Ok (23), and (59) the model holds an input worth stepping *)
  ?sensitivity_reason : string option;    (* (59) why there is no sensitivity block *)
  ?belief_map : belief_map option;        (* present on an Ok record with a growth-then-terminal structure: dcf, dcf_midcycle, reit_ffo_dividend (23) *)
  ?belief_map_reason : string option;     (* present instead on an Ok record without one: the residual-income paths (23) *)
  ?belief_version : string option;        (* (24) on every Ok record that used a belief; absent (null) on a run without one for the name *)
  ?belief : belief_readout option;        (* (24) present iff belief_version is *)
  ?belief_reason : string option;         (* (24) why an Ok record has no belief: the residual-income path, or no declaration for the class or name *)
  ?cost_of_equity_capm : float option;    (* (34) rf + beta x ERP (+ country premium), the chain as always; on every Ok record *)
  ?cost_of_equity_used : float option;    (* (34) the rate the model, the readouts, the sensitivity, the map and the probability ran on *)
  ?required_return_source : string option;   (* (34) capm | declared: class <name> | declared: name *)
  ?required_return_version : string option;  (* (34) as_of, a hash of the three fields, class or name; absent (null) under capm *)
  ?surplus_curve : surplus_point list option;   (* (35) the value surplus at 41 evenly spaced long-run growths from the belief's floor to its ceiling, everything else held; present iff the record has a belief *)
  ?surplus_curve_reason : string option;        (* (35) why there is none: no belief on the record *)
  ?market_implied : market_implied option;      (* (36) present on an Ok record when --options DIR holds a chain for the name and a usable expiry *)
  ?market_implied_reason : string option;       (* (36) present instead under --options: no options data | no expiry ... | smile fit failed: ... ; neither field without --options *)
  ?receipt_check : receipt_check option;        (* (42) present iff the financials carry cover_page_shares and the name has a declared ratio or a cross-currency listing *)
  ?stretch : stretch option;                    (* (52) copied from the financials; never fails a record *)
  ?stretch_reason : string option;
  ?insiders : insiders option;                  (* (66) copied from the financials; never fails a record *)
  ?insiders_reason : string option;             (* (66) present instead: no CIK, no Form 4 filed, or the issuer files none *)
  ?build_out : build_out option;                (* (60) on a Cyclical or OperatingCompany record that failed the observation or free-cash-flow guard with capex above depreciation and positive EBIT; never a fair value *)
  ?build_out_reason : string option;            (* (60) present instead on such a record: why there is no readout *)
  ?earnings : earnings option;                  (* (68) the calendar from the financials with the implied event move from the store; on every record, Ok or Failed; never a fair value *)
  ?earnings_reason : string option;             (* (68) present instead: why there is no block *)
  ?runway : runway option;                      (* (76) on an Unprofitable record: cash against the burn as this tool reads it, and the releases inside it; never a fair value, a floor or a signal *)
  ?runway_reason : string option;               (* (76) present instead on an Unprofitable record: why there is no readout *)
  ?options_expected_return : options_expected_return option;   (* under --options: the Martin-Wagner expected return from the options store, beside cost_of_equity_capm *)
  ?options_expected_return_reason : string option;             (* present instead under --options on a name that is not a fund: why there is none *)
  ?base_rate : base_rate option;                (* on a dollar record valued by a DCF-shaped model: how often companies of this size grew as fast as the record assumes and as the price needs *)
  ?base_rate_reason : string option;            (* present instead on such a record: why there is none *)
  ?rd_shadow : rd_shadow option;                (* on a record routed to the generic DCF: the value with research and development capitalised, beside the headline and never replacing it *)
  ?rd_shadow_reason : string option;            (* present instead on such a record: why there is no shadow *)
}
