(library
 (name atemoya)
 (public_name atemoya)
 (libraries atdgen-runtime yojson))

; Types and JSON serialisers are generated from the schemas; nothing here hand-writes them.
(rule
 (targets boundary_t.ml boundary_t.mli)
 (deps %{project_root}/schema/boundary.atd)
 (action
  (run atdgen -t -o boundary %{deps})))

(rule
 (targets boundary_j.ml boundary_j.mli)
 (deps %{project_root}/schema/boundary.atd)
 (action
  (run atdgen -j -o boundary %{deps})))

(rule
 (targets reference_t.ml reference_t.mli)
 (deps %{project_root}/schema/reference.atd)
 (action
  (run atdgen -t -o reference %{deps})))

(rule
 (targets reference_j.ml reference_j.mli)
 (deps %{project_root}/schema/reference.atd)
 (action
  (run atdgen -j -o reference %{deps})))
